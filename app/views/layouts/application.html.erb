    <% if user_signed_in? %><script>window.SMART_TAMBON_MAP_DEFAULTS = <%= raw json_escape(map_defaults.to_json) %>;</script><% end %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@10.6.1/ol.css">
    <script src="https://cdn.jsdelivr.net/npm/ol@10.6.1/dist/ol.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.20/dist/hls.min.js" defer></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cesium@1.125.0/Build/Cesium/Widgets/widgets.css">
    <script>
      window.CESIUM_BASE_URL = "https://cdn.jsdelivr.net/npm/cesium@1.125.0/Build/Cesium/";
      // CesiumJS is several MB, so it is fetched only when a 3D view is opened, not on every page load.
      window.loadCesium = () => window.Cesium ? Promise.resolve(window.Cesium) : (window.cesiumRequest ||= new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src = `${window.CESIUM_BASE_URL}Cesium.js`;
        script.onload = () => resolve(window.Cesium);
        script.onerror = () => { window.cesiumRequest = null; reject(new Error("ไม่สามารถโหลดแผนที่ 3D ได้")); };
        document.head.appendChild(script);
      }));
    </script>
