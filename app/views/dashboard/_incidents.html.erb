<% status_labels = { "pending" => "รอรับเรื่อง", "assessing" => "กำลังประเมิน", "in_progress" => "กำลังดำเนินการ", "completed" => "เสร็จสิ้น" } %>
<% severity_labels = { "critical" => "วิกฤต", "very_urgent" => "เร่งด่วนมาก", "urgent" => "เร่งด่วน", "non_urgent" => "ไม่เร่งด่วน", "general" => "ทั่วไป", "waiting" => "ไม่เร่งด่วน", "watch" => "เร่งด่วน" } %>
<% total_count = @incidents.size %>
<% summary_noun = @incident_category == "disaster" ? "ภัยพิบัติ" : "เหตุการณ์" %>

<section class="incident-page" data-incident-page>
  <div class="incident-page-heading">
    <div><p class="page-kicker"><%= @incident_category == "disaster" ? "ศูนย์บริหารจัดการภัยพิบัติ" : "ศูนย์รับแจ้งเหตุประชาชน" %></p><h1><%= @incident_category == "disaster" ? "ภัยพิบัติ" : "เหตุการณ์ทั่วไป" %></h1><p>ดูรายละเอียด ตำแหน่ง การดำเนินงาน แผนรับมือ และทรัพยากรของแต่ละเหตุ</p></div>
    <% if @allow_incident_creation %><div class="incident-heading-actions"><% if current_user.subdistrict_id.present? || current_user.access_area.present? %><button type="button" class="incident-secondary-action" data-open-incident-dialog="share-incident-form-dialog"><span class="material-symbols-outlined">share</span>แชร์แบบฟอร์ม</button><% end %><button type="button" class="incident-primary-action" data-open-incident-dialog="new-incident-dialog"><span class="material-symbols-outlined">add</span>บันทึกเหตุการณ์ใหม่</button></div><% end %>
  </div>

  <% if notice %><div class="incident-flash success"><%= notice %></div><% end %>
  <% if alert %><div class="incident-flash error"><%= alert %></div><% end %>

  <section class="incident-summary-grid" aria-label="สรุปจำนวนเหตุการณ์">
    <article class="summary-total"><span class="material-symbols-outlined">dataset</span><div><small><%= summary_noun %>ทั้งหมด</small><strong><%= @incident_summary[:total] %></strong></div></article>
    <article class="summary-pending"><span class="material-symbols-outlined">hourglass_top</span><div><small><%= summary_noun %>ที่รอรับเรื่อง</small><strong><%= @incident_summary[:pending] %></strong></div></article>
    <article class="summary-progress"><span class="material-symbols-outlined">pending_actions</span><div><small><%= summary_noun %>กำลังดำเนินการ</small><strong><%= @incident_summary[:in_progress] %></strong></div></article>
    <article class="summary-completed"><span class="material-symbols-outlined">task_alt</span><div><small><%= summary_noun %>เสร็จสิ้น</small><strong><%= @incident_summary[:completed] %></strong></div></article>
  </section>

  <% if @incidents.empty? %>
    <section class="incident-empty"><span class="material-symbols-outlined">notifications</span><h2><%= @incident_category == "disaster" ? "ยังไม่มีเหตุการณ์ที่เปิดเป็นภัยพิบัติ" : "ยังไม่มีเหตุการณ์ที่ประชาชนแจ้งเข้ามา" %></h2><p><%= @incident_category == "disaster" ? "เมื่อ Admin เปิดเหตุการณ์ทั่วไปเป็นภัยพิบัติ รายการจะแสดงในหน้านี้" : "รายการรับแจ้งใหม่ทั้งหมดจะแสดงเป็นเหตุการณ์ทั่วไปในหน้านี้" %></p></section>
  <% else %>
    <div class="incident-layout">
      <aside class="incident-list-panel">
        <div class="incident-list-title"><b>รายการรับแจ้ง</b><span data-incident-visible-count><%= total_count %> รายการ</span></div>
        <nav class="incident-status-tags" aria-label="กรองรายการตามสถานะ" data-incident-status-filters>
          <button type="button" class="active" data-incident-status-filter="pending">รอรับเรื่อง <small><%= @incident_status_counts[:pending] %></small></button>
          <button type="button" data-incident-status-filter="in_progress">กำลังดำเนินการ <small><%= @incident_status_counts[:in_progress] %></small></button>
          <button type="button" data-incident-status-filter="completed">เสร็จสิ้น <small><%= @incident_status_counts[:completed] %></small></button>
          <button type="button" data-incident-status-filter="all">ทั้งหมด <small><%= @incident_status_counts[:all] %></small></button>
        </nav>
        <div class="incident-list" data-incident-card-list>
          <% @incidents.each do |incident| %>
            <% status_group = incident.status == "pending" ? "pending" : (incident.status == "completed" ? "completed" : "in_progress") %>
            <%= link_to "#{@incidents_path}?incident_id=#{incident.id}", class: "incident-list-card incident-severity-#{incident.severity} #{'active' if incident == @selected_incident}", data: { incident_status_group: status_group, incident_source: incident.report_source_label } do %>
              <div><small><%= incident.reference_code %></small><em class="severity-<%= incident.severity %>"><%= severity_labels[incident.severity] %></em></div>
              <strong><%= incident.title %></strong>
              <p><span class="material-symbols-outlined">location_on</span><%= incident.location_name.presence || "ไม่ระบุตำแหน่ง" %></p>
              <footer><span><%= incident.report_source_label %></span><b><%= status_labels[incident.status] %></b></footer>
            <% end %>
          <% end %>
          <p class="incident-filter-empty" data-incident-filter-empty hidden>ไม่มีเหตุการณ์ในสถานะนี้</p>
        </div>
      </aside>

      <% incident = @selected_incident %>
      <article class="incident-detail-panel">
        <header class="incident-detail-header">
          <div><small><%= incident.category_label %> · <%= incident.reference_code %></small><div class="incident-title-row"><h2><%= incident.title %></h2><em class="severity-<%= incident.severity %>"><%= severity_labels[incident.severity] %></em></div></div>
          <div class="incident-header-actions">
            <% if incident.status == "pending" %><button type="button" class="incident-acknowledge-button" data-open-incident-dialog="acknowledge-incident-dialog">รับเรื่อง</button><% end %>
            <div class="incident-settings-menu" data-incident-settings-menu>
              <button type="button" class="incident-settings-trigger" data-incident-settings-trigger aria-label="จัดการข้อมูลเหตุการณ์" aria-expanded="false"><span class="material-symbols-outlined">settings</span></button>
              <div class="incident-settings-options" data-incident-settings-options hidden>
                <button type="button" data-open-incident-dialog="edit-incident-dialog"><span class="material-symbols-outlined">edit</span>แก้ไขข้อมูล</button>
                <button type="button" class="danger" data-open-incident-dialog="delete-incident-dialog"><span class="material-symbols-outlined">delete</span>ลบข้อมูล</button>
              </div>
            </div>
          </div>
        </header>

        <section class="incident-status-strip">
          <div><small>สถานะการทำงาน</small><b><%= status_labels[incident.status] %></b></div>
          <div><small>ผู้รับผิดชอบ</small><b><%= incident.assigned_to.presence || "ยังไม่ได้มอบหมาย" %></b></div>
          <div><small>ผู้รับเรื่อง</small><b><%= incident.received_by.presence || "ยังไม่มีผู้รับเรื่อง" %></b></div>
          <div><small>อัปเดตล่าสุด</small><b><%= thai_short_datetime(incident.updated_at) %></b></div>
          <div class="incident-work-actions"><% if %w[assessing in_progress].include?(incident.status) %><button type="button" class="incident-primary-action compact" data-open-incident-dialog="progress-incident-dialog">อัปเดตการทำงาน</button><% end %><% if incident.category == "disaster" && incident.status != "completed" %><%= link_to "ประเมินสถานการณ์", assessment_incident_path(incident), class: "incident-secondary-action compact" %><% end %></div>
        </section>

        <div class="incident-information-grid">
          <section class="incident-card">
            <h3>รายละเอียดเหตุการณ์</h3>
            <p><%= incident.description.presence || "ไม่มีรายละเอียดเพิ่มเติม" %></p>
            <% event_time = incident.backdated? && incident.occurred_at.present? ? incident.occurred_at : incident.created_at %>
            <dl><div><dt>วันที่และเวลาเกิดเหตุ</dt><dd><%= thai_short_datetime(event_time) %></dd></div><div><dt>แหล่งที่มา</dt><dd><%= incident.report_source_label %></dd></div><div><dt>ผู้แจ้งเหตุ</dt><dd><%= incident.reporter_name.presence || "ไม่ระบุ" %></dd></div><div><dt>เบอร์ติดต่อ</dt><dd><%= incident.reporter_contact.presence || "ไม่ระบุ" %></dd></div><div><dt>ผลกระทบเบื้องต้น</dt><dd><%= incident.initial_impact.presence || (incident.affected_people.to_i.positive? || incident.affected_households.to_i.positive? ? "ประชาชน #{incident.affected_people} คน · #{incident.affected_households} ครัวเรือน" : "ยังไม่มีข้อมูล") %></dd></div></dl>
            <% if incident.category == "general" && %w[assessing in_progress].include?(incident.status) && (current_user.system_admin? || current_user.subdistrict_admin?) %><div class="incident-card-heading incident-promotion-heading"><div><h3>การยกระดับเหตุการณ์</h3><p>ยกระดับเหตุการณ์เป็นภัยพิบัติเพื่อประเมินพื้นที่ผลกระทบและทรัพยากรที่ต้องใช้</p></div><%= button_to promote_incident_to_disaster_path(incident), method: :patch, class: "incident-secondary-action compact incident-disaster-action", form: { data: { turbo_confirm: "ยืนยันเปิดเหตุการณ์นี้เป็นภัยพิบัติ?" } } do %><span class="material-symbols-outlined">warning</span>แจ้งเหตุภัยพิบัติ<% end %></div><% end %>
          </section>
          <section class="incident-card incident-location-card">
            <h3>ตำแหน่งเหตุการณ์</h3>
            <% if incident.longitude.present? && incident.latitude.present? %>
              <div class="incident-mini-map" data-incident-map data-longitude="<%= incident.longitude %>" data-latitude="<%= incident.latitude %>" aria-label="แผนที่ตำแหน่งเหตุการณ์"></div>
              <p><%= incident.latitude %>, <%= incident.longitude %></p>
            <% else %><div class="incident-location-empty">ยังไม่มีพิกัดตำแหน่ง</div><% end %>
          </section>
        </div>

        <% if incident.response_plan_versions.any? %>
          <section class="incident-card incident-plan-card">
            <div class="incident-card-heading"><div><h3>แผนรับมือของเหตุการณ์นี้</h3><p>เลือกดูแต่ละ Version และกำหนด Version ที่ต้องการนำไปใช้</p></div></div>
            <nav class="incident-plan-tabs">
              <% incident.response_plan_versions.sort_by { |version| -version["version"].to_i }.each do |version| %>
                <%= link_to "#{@incidents_path}?incident_id=#{incident.id}&plan_version=#{version['version']}", class: "#{'active' if version == @selected_plan}" do %>
                  <b>v<%= version["version"] %> <%= "ใช้งานปัจจุบัน" if version["version"].to_i == incident.active_plan_version.to_i %></b><small><%= version["title"].presence || "แผนรับมือ" %></small>
                <% end %>
              <% end %>
            </nav>
            <% if @selected_plan %>
              <div class="incident-plan-summary"><div><small>พื้นที่ได้รับผลกระทบ</small><b><%= @selected_plan.key?("area_sq_km") ? "#{number_with_delimiter(@selected_plan['area_sq_km'].to_f.round(3))} ตร.กม." : "—" %></b></div><div><small>ประชากรที่ได้รับผลกระทบ</small><b><%= @selected_plan.key?("affected_people") ? "#{number_with_delimiter(@selected_plan['affected_people'].to_i)} คน" : "—" %></b></div><div><small>ครัวเรือนที่ได้รับผลกระทบ</small><b><%= @selected_plan.key?("affected_households") ? "#{number_with_delimiter(@selected_plan['affected_households'].to_i)} ครัวเรือน" : "—" %></b></div><div><small>วันที่ประเมิน</small><b><%= thai_incident_datetime(@selected_plan["assessed_at"]) %></b></div></div>
              <% plan_resources = Array(@selected_plan["resources"]) %>
              <div class="incident-plan-resources"><table><thead><tr><th>ทรัพยากรตามแผน</th><th>ต้องใช้</th><th>มีพร้อมใช้</th><th>ผลประเมิน</th></tr></thead><tbody><% plan_resources.each do |resource| %><tr><td><%= resource["name"] %></td><td><%= resource["required"] %> <%= resource["unit"] %></td><td><%= resource["available"] %> <%= resource["unit"] %></td><td><span class="<%= resource["available"].to_f >= resource["required"].to_f ? 'enough' : 'shortage' %>"><%= resource["available"].to_f >= resource["required"].to_f ? "เพียงพอ" : "ไม่เพียงพอ" %></span></td></tr><% end %></tbody></table></div>
              <% unless @selected_plan["version"].to_i == incident.active_plan_version.to_i %><%= button_to "เลือกใช้ Version นี้", activate_incident_plan_path(incident), method: :patch, params: { version: @selected_plan["version"] }, class: "incident-use-plan" %><% end %>
            <% end %>
          </section>
        <% end %>

        <section class="incident-card incident-history-card"><div class="incident-card-heading"><div><h3>ประวัติการดำเนินงาน</h3><p>ลำดับการรับเรื่อง การประเมิน และการปฏิบัติงาน</p></div></div><ol><% Array(incident.histories).reverse_each do |history| %><li><div><b><%= history["title"] %></b><p><%= history["description"] %></p><% Array(history["resources"]).each do |resource| %><span><%= resource["name"] %> <%= resource["quantity"] %> <%= resource["unit"] %></span><% end %></div><time><%= thai_incident_datetime(history["occurred_at"]) %><small><%= history["actor"] %></small></time></li><% end %><% if incident.histories.empty? %><li class="empty">ยังไม่มีประวัติการดำเนินงาน</li><% end %></ol></section>

        <%= render "dashboard/incident_usage_summary", incident: incident %>
      </article>
    </div>
  <% end %>

  <%= render "dashboard/incident_dialogs", incident: @selected_incident %>
</section>
