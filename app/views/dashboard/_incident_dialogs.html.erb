<dialog id="new-incident-dialog" class="incident-dialog">
  <%= form_with url: incidents_path, method: :post, scope: :incident, local: true do |form| %>
    <header><div><small>จัดการเหตุการณ์</small><h2>บันทึกเหตุการณ์ใหม่</h2></div><button type="button" data-close-incident-dialog aria-label="ปิด">×</button></header>
    <div class="incident-form-grid">
      <label>ชื่อเหตุการณ์<%= form.text_field :title, required: true %></label>
      <label>ประเภทเหตุการณ์<%= form.text_field :incident_type, placeholder: "เช่น ถนนชำรุด ไฟฟ้าขัดข้อง" %></label>
      <label>ระดับความเร่งด่วน<%= form.select :severity, [["วิกฤต", "critical"], ["เร่งด่วนมาก", "very_urgent"], ["เร่งด่วน", "urgent"], ["ไม่เร่งด่วน", "non_urgent"], ["ทั่วไป", "general"]], selected: "general" %></label>
      <label class="wide incident-backdated-option"><span><%= form.check_box :backdated, data: { incident_backdated_toggle: true } %> เป็นการบันทึกเหตุการณ์ย้อนหลัง</span></label>
      <label class="wide" data-incident-occurred-on hidden>วันที่เกิดเหตุ *<span class="incident-date-control"><%= text_field_tag nil, nil, placeholder: "วว/ดด/ปปปป", inputmode: "numeric", pattern: "\\d{2}/\\d{2}/\\d{4}", disabled: true, data: { incident_occurred_on_input: true } %><button type="button" data-incident-date-picker-button aria-label="เลือกวันที่จากปฏิทิน"><span class="material-symbols-outlined">calendar_month</span></button><%= date_field_tag nil, nil, class: "incident-native-date-picker", tabindex: -1, disabled: true, data: { incident_date_picker: true } %></span><%= hidden_field_tag nil, nil, disabled: true, data: { incident_occurred_on_value: true } %></label>
      <label class="wide" data-incident-occurred-time hidden>เวลาที่เกิดเหตุ *<span class="incident-time-control"><%= text_field_tag nil, nil, list: "new-incident-hour-options", inputmode: "numeric", maxlength: 2, autocomplete: "off", placeholder: "ชั่วโมง", disabled: true, data: { incident_time_hour: true } %><datalist id="new-incident-hour-options"><% (0..23).each do |hour| %><option value="<%= format('%02d', hour) %>"></option><% end %></datalist><%= text_field_tag nil, nil, list: "new-incident-minute-options", inputmode: "numeric", maxlength: 2, autocomplete: "off", placeholder: "นาที", disabled: true, data: { incident_time_minute: true } %><datalist id="new-incident-minute-options"><% (0..59).each do |minute| %><option value="<%= format('%02d', minute) %>"></option><% end %></datalist><b>น.</b></span><%= form.hidden_field :occurred_at, disabled: true, data: { incident_occurred_at_value: true } %></label>
      <label class="wide">รายละเอียด<%= form.text_area :description, rows: 3 %></label>
      <label>ผู้แจ้งเหตุ<%= form.text_field :reporter_name %></label><label>เบอร์ติดต่อ<%= form.text_field :reporter_contact %></label>
      <div class="wide incident-location-picker" data-incident-location-picker>
        <div><b>สถานที่เกิดเหตุ</b></div>
        <div class="incident-picker-map" data-picker-map data-default-longitude="100.9246" data-default-latitude="19.4028"></div>
        <p data-picker-coordinate>คลิกบนแผนที่เพื่อปักหมุดตำแหน่ง</p>
        <%= form.hidden_field :location_name, value: "ตำแหน่งที่ปักหมุดบนแผนที่", data: { picker_location: true } %>
        <%= form.hidden_field :latitude, data: { picker_latitude: true } %>
        <%= form.hidden_field :longitude, data: { picker_longitude: true } %>
      </div>
      <label class="wide">ผลกระทบเบื้องต้น<%= form.text_area :initial_impact, rows: 4, placeholder: "ระบุผลกระทบต่อประชาชน บ้านเรือน การเดินทาง หรือทรัพย์สิน" %></label>
    </div>
    <footer><button type="button" class="incident-secondary-action" data-close-incident-dialog>ยกเลิก</button><%= form.submit "บันทึกเหตุการณ์", class: "incident-primary-action" %></footer>
  <% end %>
</dialog>

<% if current_user.subdistrict_id.present? || current_user.access_area.present? %><dialog id="share-incident-form-dialog" class="incident-dialog small">
  <header><div><small>PUBLIC FORM</small><h2>แชร์แบบฟอร์มแจ้งเหตุ</h2></div><button type="button" data-close-incident-dialog>×</button></header>
  <% share_sources = public_report_sources %><div class="incident-share-form"><span class="material-symbols-outlined">link</span><div><strong>เลือกว่าแชร์แบบฟอร์มสำหรับผู้แจ้งกลุ่มใด</strong><p>แต่ละแหล่งที่มามีลิงก์ประจำของตัวเอง ผู้กรอกไม่สามารถเปลี่ยนชื่อแหล่งที่มาได้</p></div><label>แหล่งที่มา<select data-public-report-share-source><% share_sources.each do |source| %><option value="<%= public_incident_report_link(source_type: source[:type], source_name: source[:name]) %>"><%= source[:label] %></option><% end %></select></label><label>ลิงก์แบบฟอร์ม<input type="text" readonly value="<%= public_incident_report_link(source_type: share_sources.first[:type], source_name: share_sources.first[:name]) %>" data-public-report-share-url></label><p data-public-share-status></p></div>
  <footer><button type="button" class="incident-secondary-action" data-native-share-public-form><span class="material-symbols-outlined">ios_share</span>แชร์</button><button type="button" class="incident-primary-action" data-copy-public-form-link><span class="material-symbols-outlined">content_copy</span>คัดลอกลิงก์</button></footer>
</dialog><% end %>

<% if incident %>
  <dialog id="edit-incident-dialog" class="incident-dialog">
    <%= form_with url: incident_path(incident), method: :patch, scope: :incident, local: true do |form| %>
      <header><div><small><%= incident.reference_code %></small><h2>แก้ไขข้อมูลเหตุการณ์</h2></div><button type="button" data-close-incident-dialog>×</button></header>
      <div class="incident-form-grid">
        <label>ชื่อเหตุการณ์<%= form.text_field :title, value: incident.title, required: true %></label>
        <label>ประเภทเหตุการณ์<%= form.text_field :incident_type, value: incident.incident_type %></label>
        <% selected_severity = { "waiting" => "non_urgent", "watch" => "urgent" }.fetch(incident.severity, incident.severity) %><label>ระดับความเร่งด่วน<%= form.select :severity, [["วิกฤต", "critical"], ["เร่งด่วนมาก", "very_urgent"], ["เร่งด่วน", "urgent"], ["ไม่เร่งด่วน", "non_urgent"], ["ทั่วไป", "general"]], selected: selected_severity %></label>
        <label class="wide incident-backdated-option"><span><%= form.check_box :backdated, { checked: incident.backdated?, data: { incident_backdated_toggle: true } }, "1", "0" %> เป็นการบันทึกเหตุการณ์ย้อนหลัง</span></label>
        <% occurred_at_th = incident.occurred_at&.in_time_zone("Asia/Bangkok") %>
        <label class="wide" data-incident-occurred-on <%= "hidden" unless incident.backdated? %>>วันที่เกิดเหตุ *<span class="incident-date-control"><%= text_field_tag nil, occurred_at_th&.strftime("%d/%m/%Y"), placeholder: "วว/ดด/ปปปป", inputmode: "numeric", pattern: "\\d{2}/\\d{2}/\\d{4}", disabled: !incident.backdated?, required: incident.backdated?, data: { incident_occurred_on_input: true } %><button type="button" data-incident-date-picker-button aria-label="เลือกวันที่จากปฏิทิน"><span class="material-symbols-outlined">calendar_month</span></button><%= date_field_tag nil, occurred_at_th&.strftime("%Y-%m-%d"), class: "incident-native-date-picker", tabindex: -1, disabled: !incident.backdated?, data: { incident_date_picker: true } %></span><%= hidden_field_tag nil, occurred_at_th&.strftime("%Y-%m-%d"), disabled: !incident.backdated?, data: { incident_occurred_on_value: true } %></label>
        <label class="wide" data-incident-occurred-time <%= "hidden" unless incident.backdated? %>>เวลาที่เกิดเหตุ *<span class="incident-time-control"><%= text_field_tag nil, occurred_at_th&.strftime("%H"), list: "edit-incident-hour-options", inputmode: "numeric", maxlength: 2, autocomplete: "off", placeholder: "ชั่วโมง", disabled: !incident.backdated?, required: incident.backdated?, data: { incident_time_hour: true } %><datalist id="edit-incident-hour-options"><% (0..23).each do |hour| %><option value="<%= format('%02d', hour) %>"></option><% end %></datalist><%= text_field_tag nil, occurred_at_th&.strftime("%M"), list: "edit-incident-minute-options", inputmode: "numeric", maxlength: 2, autocomplete: "off", placeholder: "นาที", disabled: !incident.backdated?, required: incident.backdated?, data: { incident_time_minute: true } %><datalist id="edit-incident-minute-options"><% (0..59).each do |minute| %><option value="<%= format('%02d', minute) %>"></option><% end %></datalist><b>น.</b></span><%= form.hidden_field :occurred_at, value: incident.occurred_at&.iso8601, disabled: !incident.backdated?, data: { incident_occurred_at_value: true } %></label>
        <label class="wide">ทีมผู้รับผิดชอบ<%= form.select :assigned_to, options_for_select(([incident.assigned_to].compact + @incident_team_options).uniq, incident.assigned_to), { include_blank: "เลือกทีมผู้รับผิดชอบ" } %></label>
        <label class="wide">รายละเอียด<%= form.text_area :description, value: incident.description, rows: 3 %></label>
        <label>ผู้แจ้งเหตุ<%= form.text_field :reporter_name, value: incident.reporter_name %></label><label>เบอร์ติดต่อ<%= form.text_field :reporter_contact, value: incident.reporter_contact %></label>
        <div class="wide incident-location-picker" data-incident-location-picker>
          <div><b>สถานที่เกิดเหตุ</b></div>
          <div class="incident-picker-map" data-picker-map data-default-longitude="100.9246" data-default-latitude="19.4028" data-longitude="<%= incident.longitude %>" data-latitude="<%= incident.latitude %>"></div>
          <p data-picker-coordinate><%= incident.latitude.present? && incident.longitude.present? ? "#{format('%.6f', incident.latitude)}, #{format('%.6f', incident.longitude)}" : "คลิกบนแผนที่เพื่อปักหมุดตำแหน่ง" %></p>
          <%= form.hidden_field :location_name, value: incident.location_name.presence || "ตำแหน่งที่ปักหมุดบนแผนที่", data: { picker_location: true } %>
          <%= form.hidden_field :latitude, value: incident.latitude, data: { picker_latitude: true } %>
          <%= form.hidden_field :longitude, value: incident.longitude, data: { picker_longitude: true } %>
        </div>
        <label class="wide">ผลกระทบเบื้องต้น<%= form.text_area :initial_impact, value: incident.initial_impact, rows: 4, placeholder: "ระบุผลกระทบต่อประชาชน บ้านเรือน การเดินทาง หรือทรัพย์สิน" %></label>
      </div>
      <footer><button type="button" class="incident-secondary-action" data-close-incident-dialog>ยกเลิก</button><%= form.submit "บันทึกการแก้ไข", class: "incident-primary-action" %></footer>
    <% end %>
  </dialog>

  <dialog id="delete-incident-dialog" class="incident-dialog small">
    <header><div><small><%= incident.reference_code %></small><h2>ยืนยันการลบข้อมูล</h2></div><button type="button" data-close-incident-dialog>×</button></header>
    <div class="incident-delete-confirmation"><span class="material-symbols-outlined">warning</span><div><strong>ต้องการลบ “<%= incident.title %>” หรือไม่?</strong><p>รายการนี้จะถูกซ่อนออกจากหน้าระบบ แต่ข้อมูลเดิมจะยังถูกเก็บไว้ในฐานข้อมูล</p></div></div>
    <footer><button type="button" class="incident-secondary-action" data-close-incident-dialog>ยกเลิก</button><%= button_to "ยืนยันลบข้อมูล", incident_path(incident), method: :delete, class: "incident-delete-action" %></footer>
  </dialog>

  <% if incident.status == "pending" %>
    <dialog id="acknowledge-incident-dialog" class="incident-dialog small">
      <%= form_with url: acknowledge_incident_path(incident), method: :patch, scope: :incident, local: true do |form| %>
        <header><div><small><%= incident.reference_code %></small><h2>รับเรื่องเหตุการณ์</h2></div><button type="button" data-close-incident-dialog>×</button></header>
        <div class="incident-form-grid">
          <div class="wide incident-receiver-summary"><small>บัญชีผู้รับเรื่อง</small><strong><%= current_user.username %></strong><p>ระบบจะบันทึกชื่อบัญชีและเวลาที่รับเรื่องโดยอัตโนมัติ</p></div>
          <label class="wide">ทีมผู้รับผิดชอบ<%= form.select :assigned_to, options_for_select(@incident_team_options), { include_blank: "เลือกทีมผู้รับผิดชอบ" }, required: true %></label>
          <% if @incident_team_options.empty? %><p class="wide incident-form-warning">ยังไม่มีข้อมูลทีมงาน กรุณานำเข้าข้อมูลทีมงานและกำลังคนก่อนรับเรื่อง</p><% end %>
        </div>
        <footer><button type="button" class="incident-secondary-action" data-close-incident-dialog>ยกเลิก</button><%= form.submit "ยืนยันรับเรื่อง", class: "incident-primary-action", disabled: @incident_team_options.empty? %></footer>
      <% end %>
    </dialog>
  <% end %>

  <dialog id="progress-incident-dialog" class="incident-dialog progress-incident-dialog">
    <%= form_with url: incident_progress_path(incident), method: :post, scope: :progress, local: true do |form| %>
      <header><div><small><%= incident.reference_code %></small><h2>อัปเดตการทำงาน</h2></div><button type="button" data-close-incident-dialog>×</button></header>
      <div class="incident-form-grid"><label>สถานะ<%= form.select :status, [["กำลังประเมิน", "assessing"], ["กำลังดำเนินการ", "in_progress"], ["เสร็จสิ้น", "completed"]], selected: incident.status %></label><label>ผู้รับผิดชอบ<%= form.text_field :assigned_to, value: incident.assigned_to %></label><label class="wide">หัวข้อการอัปเดต<%= form.text_field :title, required: true %></label><label class="wide">รายละเอียดการดำเนินงาน<%= form.text_area :description, rows: 4 %></label><section class="wide incident-usage-picker" data-incident-usage-picker><div class="incident-usage-heading"><div><h3>ทรัพยากรและทีมงานที่ใช้</h3><p>เลือกรายการจากฐานข้อมูลและระบุจำนวนที่ใช้ในการดำเนินงานครั้งนี้</p></div><button type="button" data-add-incident-usage <%= "disabled" if @incident_usage_options.empty? %>><span class="material-symbols-outlined">add</span>เพิ่มรายการ</button></div><div data-incident-usage-list></div><template data-incident-usage-template><div class="incident-usage-row"><label>รายการ<select name="progress[usages][][key]" required><option value="">เลือกรายการ</option><% @incident_usage_options.each do |item| %><option value="<%= item[:key] %>" data-available="<%= item[:available] %>" data-unit="<%= item[:unit] %>"><%= item[:name] %> (พร้อมใช้ <%= item[:available] %> <%= item[:unit] %>)</option><% end %></select></label><label>จำนวนที่ใช้<input type="number" name="progress[usages][][quantity]" min="1" step="1" required></label><button type="button" data-remove-incident-usage aria-label="ลบรายการ"><span class="material-symbols-outlined">delete</span></button></div></template><% if @incident_usage_options.empty? %><p class="incident-form-warning">ยังไม่มีข้อมูลทรัพยากรหรือทีมงาน กรุณาเพิ่มข้อมูลในหน้านำเข้าข้อมูลก่อน</p><% else %><p class="incident-usage-empty" data-incident-usage-empty>ยังไม่ได้เพิ่มทรัพยากรหรือทีมงาน</p><% end %></section></div>
      <footer><button type="button" class="incident-secondary-action" data-close-incident-dialog>ยกเลิก</button><%= form.submit "บันทึกการทำงาน", class: "incident-primary-action" %></footer>
    <% end %>
  </dialog>

  <dialog id="assess-incident-dialog" class="incident-dialog small">
    <%= form_with url: incident_assessments_path(incident), method: :post, scope: :assessment, local: true do |form| %>
      <header><div><small><%= incident.reference_code %></small><h2>ประเมินสถานการณ์</h2></div><button type="button" data-close-incident-dialog>×</button></header>
      <div class="incident-form-grid"><label class="wide">ชื่อแผนรับมือ Version ใหม่<%= form.text_field :title, placeholder: "เช่น ปรับแผนตามระดับน้ำล่าสุด" %></label><label>ประชากรที่ได้รับผลกระทบ<%= form.number_field :affected_people, value: incident.affected_people, min: 0 %></label><label>งบประมาณ (บาท)<%= form.number_field :budget, min: 0 %></label><label class="wide">ทรัพยากรที่ต้องใช้<%= form.text_area :resource_lines, rows: 5, placeholder: "หนึ่งรายการต่อหนึ่งบรรทัด เช่น\nเรือท้องแบน | 4 | 3 | ลำ\nเจ้าหน้าที่ | 18 | 30 | คน" %><small>รูปแบบ: ชื่อ | ต้องใช้ | มีพร้อมใช้ | หน่วย</small></label><label class="wide checkbox"><%= form.check_box :activate %> ใช้ Version นี้ทันทีหลังบันทึก</label></div>
      <footer><button type="button" class="incident-secondary-action" data-close-incident-dialog>ยกเลิก</button><%= form.submit "บันทึกผลประเมิน", class: "incident-primary-action" %></footer>
    <% end %>
  </dialog>
<% end %>
