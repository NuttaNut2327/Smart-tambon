<div class="shell dashboard-shell gis-dashboard data-layers-shell">
  <%= render "dashboard/sidebar", active_nav: :data_layers, initial_area: @area_label %>
  <main class="dashboard-main content"><header class="dashboard-header gis-topbar"><div><p class="topbar-kicker"><%= system_name %></p><span class="breadcrumb"><span id="selection-label"><%= @area_label %></span><b>›</b><span>นำเข้าข้อมูล</span></span></div></header><div class="dashboard-content import-workspace">
    <section class="city-heading import-heading"><div><h1>คลังข้อมูลไฟล์</h1><p>ไฟล์ต้นฉบับของทุก Version ที่นำเข้า สามารถดาวน์โหลดกลับมาใช้งานได้</p></div></section>
    <div class="import-layout"><%= render "data_layers/dataset_type_nav", active_type: "file_library" %>
      <section class="dataset-catalog fixed-catalog"><div class="catalog-hero"><div><span>▧</span><div><h2>ไฟล์ที่นำเข้า</h2><p>รายการไฟล์จากชุดข้อมูลที่คุณเข้าถึงได้</p></div></div><b><%= @file_versions.size %> ไฟล์</b></div><div class="fixed-table-wrap"><table class="fixed-data-table"><thead><tr><th>ชื่อไฟล์</th><th>ประเภทของข้อมูล</th><th>ชุดข้อมูล</th><th>รุ่นข้อมูล</th><th>ชนิดการนำเข้า</th><th>วันที่นำเข้า</th><th>จัดการ</th></tr></thead><tbody><% @file_versions.each do |item| %><% dataset = item[:dataset]; version = item[:version]; data_category = case dataset.data_type when "population" then "ข้อมูลประชากร" when "resources" then "ข้อมูลทรัพยากรและอุปกรณ์" when "consumables" then "วัสดุสิ้นเปลือง" when "workforce" then "บุคลากรปฏิบัติงาน" else dataset.name.match?(/ขอบเขต|boundary/i) ? "ข้อมูลขอบเขตพื้นที่" : dataset.name.match?(/แจ้งเหตุ|เหตุการณ์|incident/i) ? "ข้อมูลแจ้งเหตุการณ์" : "ข้อมูลกำหนดเอง" end %><tr><td><%= version.source_filename %></td><td><span class="file-data-category"><%= data_category %></span></td><td><%= link_to dataset.display_name, imported_dataset_path(dataset), class: "table-action" %></td><td>v<%= version.version_number %></td><td>นำเข้าไฟล์</td><td><%= thai_numeric_datetime(version.created_at) %></td><td><%= link_to "ดาวน์โหลด", download_imported_dataset_version_path(dataset, version), class: "table-action" %></td></tr><% end %><% if @file_versions.empty? %><tr class="empty-row"><td colspan="7">ยังไม่มีไฟล์ที่นำเข้าในคลังข้อมูล</td></tr><% end %></tbody></table></div></section>
    </div>
  </div></main>
</div>
