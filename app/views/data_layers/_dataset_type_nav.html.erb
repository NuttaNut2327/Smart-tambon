<% active_type = local_assigns[:active_type].to_s %>
<aside class="dataset-type-nav">
  <h3>ข้อมูลทั่วไปของ อบต.</h3>
  <% [["population", "groups", "ข้อมูลประชากร"], ["agencies", "account_balance", "หน่วยงาน"], ["teams", "group_work", "ทีมปฏิบัติงาน"], ["workforce", "badge", "บุคลากรปฏิบัติงาน"], ["resources", "construction", "ทรัพยากรและอุปกรณ์"], ["consumables", "inventory_2", "วัสดุสิ้นเปลือง"]].each do |key, icon, label| %>
    <%= link_to data_layers_path(data_type: key), class: "dataset-type-link #{'active' if active_type == key}" do %>
      <span class="material-symbols-outlined dataset-nav-icon"><%= icon %></span><%= label %><b class="material-symbols-outlined dataset-nav-arrow">chevron_right</b>
    <% end %>
  <% end %>

  <h3>ข้อมูลอุปกรณ์</h3>
  <% [["water_level_sensors", "water_drop", "เซนเซอร์วัดระดับน้ำ"], ["pm25_sensors", "air", "เซนเซอร์วัด PM 2.5"]].each do |key, icon, label| %>
    <%= link_to data_layers_path(data_type: key), class: "dataset-type-link #{'active' if active_type == key}" do %>
      <span class="material-symbols-outlined dataset-nav-icon"><%= icon %></span><%= label %><b class="material-symbols-outlined dataset-nav-arrow">chevron_right</b>
    <% end %>
  <% end %>

  <h3>ชุดข้อมูลแบบกำหนดเอง</h3>
  <%= link_to imported_datasets_path, class: "dataset-type-link custom #{'active' if active_type == 'custom'}" do %>
    <span class="material-symbols-outlined dataset-nav-icon">add_box</span>รายการชุดข้อมูล<b class="material-symbols-outlined dataset-nav-arrow">chevron_right</b>
  <% end %>

  <h3>คลังข้อมูลไฟล์</h3>
  <%= link_to data_layers_path(data_type: "file_library"), class: "dataset-type-link #{'active' if active_type == 'file_library'}" do %>
    <span class="material-symbols-outlined dataset-nav-icon">folder_open</span>คลังข้อมูลไฟล์<b class="material-symbols-outlined dataset-nav-arrow">chevron_right</b>
  <% end %>
</aside>
