<div class="shell dashboard-shell gis-dashboard data-layers-shell">
  <aside class="dashboard-sidebar sidebar"><div class="dashboard-brand brand"><span class="brand-symbol">⌂</span><div><strong>SMART TAMBON</strong><small>SMART GIS PLATFORM</small></div></div><div class="scope-summary"><small>พื้นที่ดำเนินการ</small><div><b><%= current_user.system_admin? ? "ทุกพื้นที่ทั่วประเทศ" : @area_label %></b></div></div><div class="sidebar-menu-label">เมนูหลัก</div><nav class="primary-nav"><%= link_to root_path, class: "primary-nav-item", data: { turbo: false } do %><span>⌂</span>ภาพรวมเมือง<% end %><%= link_to area_analysis_path, class: "primary-nav-item", data: { turbo: false } do %><span>⌖</span>การวิเคราะห์แผนที่<% end %><%= link_to disasters_path, class: "primary-nav-item", data: { turbo: false } do %><span>!</span>ภัยพิบัติและเหตุการณ์ <em>3</em><% end %><%= link_to data_layers_path, class: "primary-nav-item active", data: { turbo: false } do %><span>⇧</span>นำเข้าข้อมูล<% end %><% if system_admin? %><%= link_to users_path, class: "primary-nav-item" do %><span>♙</span>จัดการบัญชี<% end %><% end %></nav><div class="sidebar-user user"><div class="avatar"><%= current_user.username.first.upcase %></div><div><b><%= current_user.username %></b><small><%= current_user.role_label %></small></div></div></aside>
  <main class="dashboard-main content"><header class="dashboard-header gis-topbar"><div><p class="topbar-kicker">DATA MANAGEMENT</p><span class="breadcrumb">นำเข้าข้อมูล <b>›</b> <%= ImportedDataset::TYPE_LABELS.fetch(@selected_type) %></span></div></header><div class="dashboard-content import-workspace">
    <% if notice %><div class="import-flash success"><%= notice %></div><% end %><% if alert %><div class="import-flash error"><%= alert %></div><% end %>
    <section class="city-heading import-heading"><div><h1>นำเข้าข้อมูล</h1><p>จัดการข้อมูลเฉพาะพื้นที่ พร้อม Version ประวัติไฟล์ และชั้นข้อมูลบนแผนที่</p></div><% if @can_upload %><div class="import-heading-actions"><button class="button-link" type="button" data-open-manual>＋ เพิ่มข้อมูลด้วยตนเอง</button><button class="data-layer-add" type="button" data-open-import>⇧ นำเข้าไฟล์</button></div><% end %></section>
    <div class="import-layout"><aside class="dataset-type-nav"><h3>ชุดข้อมูลตามระบบ</h3><% [["population","ข้อมูลประชากร"],["resources","ทรัพยากรและอุปกรณ์"],["workforce","ทีมงานและกำลังคน"]].each do |key,label| %><%= link_to data_layers_path(data_type: key), class: "dataset-type-link #{'active' if @selected_type == key}" do %><span>▤</span><%= label %><b>›</b><% end %><% end %><h3>ชุดข้อมูลแบบกำหนดเอง</h3><%= link_to imported_datasets_path, class: "dataset-type-link custom" do %><span>＋</span>รายการชุดข้อมูล<b>›</b><% end %><h3>คลังข้อมูลไฟล์</h3><%= link_to data_layers_path(data_type: "file_library"), class: "dataset-type-link" do %><span>▧</span>คลังข้อมูลไฟล์<b>›</b><% end %><div class="dataset-legend"><b>โครงสร้างข้อมูล</b><p><i></i> ตามระบบ — คอลัมน์มาตรฐานคงที่</p><p><i class="custom"></i> กำหนดเอง — สร้างคอลัมน์ได้เอง</p></div></aside>
      <section class="dataset-catalog fixed-catalog"><div class="catalog-hero"><div><span>▤</span><div><h2><%= ImportedDataset::TYPE_LABELS.fetch(@selected_type) %></h2><p>โครงสร้างคอลัมน์มาตรฐาน พร้อมนำไปสร้างชั้นข้อมูลบนแผนที่</p></div></div><b><%= @fixed_record_total %> รายการ</b></div><div class="catalog-toolbar"><input type="search" placeholder="ค้นหาข้อมูล" data-fixed-search><span><%= @selected_datasets.size %> ชุดข้อมูล · <%= @fixed_record_total %> รายการ</span></div>
        <div class="fixed-table-wrap"><table class="fixed-data-table"><thead><tr><% @selected_schema.each do |field| %><th><%= field["label"] %></th><% end %><th>อัปเดตล่าสุด</th><th class="record-actions-heading">จัดการ</th></tr></thead><tbody><% @fixed_records.each do |item| %><tr data-fixed-row data-search="<%= item[:record].values.join(' ').downcase %>"><% @selected_schema.each do |field| %><td><%= item[:record][field["key"]].presence || "—" %></td><% end %><td><span class="fixed-data-date"><%= thai_short_datetime(item[:dataset].updated_at) %></span></td><td class="record-actions"><% if item[:editable] %><button type="button" class="record-icon-button edit" title="แก้ไขข้อมูล" aria-label="แก้ไขข้อมูล" data-edit-population data-url="<%= imported_dataset_record_path(item[:dataset], item[:position]) %>" data-record="<%= item[:record].to_json %>">✎</button><button type="button" class="record-icon-button delete" title="ลบข้อมูล" aria-label="ลบข้อมูล" data-delete-population data-url="<%= imported_dataset_record_path(item[:dataset], item[:position]) %>">♲</button><% else %><span class="record-readonly">ดูอย่างเดียว</span><% end %></td></tr><% end %><% if @fixed_records.empty? %><tr class="empty-row"><td colspan="<%= @selected_schema.size + 2 %>">ยังไม่มีข้อมูลประเภทนี้ เริ่มเพิ่มด้วยตนเองหรือนำเข้าไฟล์ได้ทันที</td></tr><% end %></tbody></table></div><% if @fixed_record_total > @fixed_page_size %><nav class="fixed-pagination" aria-label="เปลี่ยนหน้าข้อมูล"><span>แสดง <%= ((@fixed_page - 1) * @fixed_page_size) + 1 %>–<%= [@fixed_page * @fixed_page_size, @fixed_record_total].min %> จาก <%= @fixed_record_total %> รายการ</span><div><%= link_to "‹", data_layers_path(data_type: @selected_type, page: @fixed_page - 1), class: "page-button #{'disabled' if @fixed_page == 1}", aria: { label: "หน้าก่อนหน้า" } %><% (1..@fixed_total_pages).each do |page| %><%= link_to page, data_layers_path(data_type: @selected_type, page: page), class: "page-button #{'active' if page == @fixed_page}" %><% end %><%= link_to "›", data_layers_path(data_type: @selected_type, page: @fixed_page + 1), class: "page-button #{'disabled' if @fixed_page == @fixed_total_pages}", aria: { label: "หน้าถัดไป" } %></div></nav><% end %>
      </section></div>
    <% if @dataset_summaries.any? %>
      <section class="dataset-current-panel">
        <div class="section-card-heading"><div><h2>ข้อมูล Version ปัจจุบันและการแสดงบนแผนที่</h2><p>ข้อมูลที่ระบบใช้แสดงอยู่ในขณะนี้ของแต่ละชุดข้อมูล</p></div><span><%= @dataset_summaries.size %> ชุดข้อมูล</span></div>
        <div class="dataset-current-grid"><% @dataset_summaries.each do |item| %><% dataset = item[:dataset]; version = item[:current_version] %><article class="dataset-current-card"><div class="dataset-current-title"><div><b><%= dataset.name %></b><small><%= dataset.type_label %></small></div></div><dl><div><dt>Version ที่ใช้อยู่</dt><dd><%= version ? "v#{version.version_number}" : "—" %></dd></div><div><dt>จำนวนข้อมูล</dt><dd><%= version&.record_count.to_i %> รายการ</dd></div><div><dt>การแสดงบนแผนที่</dt><dd class="map-state <%= dataset.map_enabled? ? 'enabled' : 'disabled' %>"><%= dataset.map_enabled? ? "เปิดใช้งาน" : "ยังไม่ได้สร้างชั้นข้อมูล" %></dd></div><div><dt>รูปแบบข้อมูลแผนที่</dt><dd><%= dataset.map_enabled? ? (dataset.geometry_type == 'point' ? 'จุดตำแหน่ง' : dataset.geometry_type) : '—' %></dd></div></dl><small class="dataset-current-date">อัปเดตล่าสุด <%= version&.created_at&.strftime('%d/%m/%Y %H:%M') || '—' %></small></article><% end %></div>
      </section>
      <section class="dataset-version-panel">
        <div class="section-card-heading"><div><h2>ประวัติ Version</h2><p>เก็บข้อมูลเดิมและไฟล์ต้นฉบับไว้ทุกครั้งที่มีการนำเข้าหรือแก้ไข</p></div><span><%= @version_history.size %> Version</span></div>
        <div class="version-history-cards"><% @version_history.each do |item| %><% dataset = item[:dataset]; version = item[:version] %><article class="version-history-card <%= 'current' if dataset.current_version_id == version.id %>"><div class="version-history-top"><span class="version-history-badge">v<%= version.version_number %></span><% if dataset.current_version_id == version.id %><em>ใช้งานอยู่</em><% end %></div><b><%= dataset.name %></b><p><%= version.change_note.presence || (version.source_kind == 'manual' ? 'เพิ่มหรือแก้ไขข้อมูลด้วยตนเอง' : 'นำเข้าข้อมูลจากไฟล์') %></p><small><%= version.record_count %> รายการ · <%= version.created_at.strftime('%d/%m/%Y %H:%M') %></small><div><%= link_to "ดาวน์โหลดไฟล์", download_imported_dataset_version_path(dataset, version), class: "table-action" if version.downloadable? %></div></article><% end %></div>
      </section>
    <% end %>
  </div></main>
</div>

<% if @can_upload %>
  <dialog class="dataset-modal" id="manual-data-dialog"><form id="manual-data-form"><header><div><small>เพิ่มข้อมูลแบบกรอกตรง</small><h2>เพิ่ม<%= ImportedDataset::TYPE_LABELS.fetch(@selected_type) %>ด้วยตนเอง</h2></div><button type="button" data-close-dialog>×</button></header><div class="modal-info">กรอกข้อมูลตามคอลัมน์มาตรฐาน ช่องที่มีเครื่องหมาย * จำเป็นต้องกรอก</div><div class="manual-fixed-grid"><% @selected_schema.each do |field| %><label><%= field["label"] %><%= " *" if field["required"] %><input name="record[<%= field['key'] %>]" type="<%= field['type'] == 'number' ? 'number' : field['type'] == 'date' ? 'date' : 'text' %>" <%= "required" if field["required"] %> step="any"></label><% end %></div><%= render "import_destination_fields", selected_type: @selected_type, editable_datasets: @editable_datasets, subdistricts: @subdistricts %><input type="hidden" name="data_type" value="<%= @selected_type %>"><p class="modal-status" data-manual-status></p><footer><button type="button" class="button-link" data-close-dialog>ยกเลิก</button><button class="data-layer-add" type="submit">บันทึกและเพิ่มในรายการ</button></footer></form></dialog>
  <dialog class="dataset-modal" id="edit-population-dialog"><form id="edit-population-form"><header><div><small>แก้ไข<%= ImportedDataset::TYPE_LABELS.fetch(@selected_type) %></small><h2>แก้ไขรายการ</h2></div><button type="button" data-close-dialog>×</button></header><div class="modal-info">เมื่อบันทึก ระบบจะสร้าง Version ใหม่และเก็บข้อมูลเดิมไว้ในประวัติ</div><div class="manual-fixed-grid"><% @selected_schema.each do |field| %><label><%= field["label"] %><%= " *" if field["required"] %><input name="record[<%= field['key'] %>]" data-edit-field="<%= field['key'] %>" type="<%= %w[number integer].include?(field['type']) ? 'number' : 'text' %>" <%= "required" if field["required"] %> step="any"></label><% end %></div><label class="record-change-note">รายละเอียดการแก้ไข<input name="change_note" placeholder="ระบุรายละเอียดที่แก้ไข"></label><p class="modal-status" data-edit-status></p><footer><button type="button" class="button-link" data-close-dialog>ยกเลิก</button><button class="data-layer-add" type="submit">บันทึกเป็น Version ใหม่</button></footer></form></dialog>
  <dialog class="dataset-modal import-wizard-modal" id="file-import-dialog" data-selected-type="<%= @selected_type %>"><div class="wizard-shell"><header><div><small>นำเข้าชุดข้อมูลตามระบบ</small><h2>นำเข้า<%= ImportedDataset::TYPE_LABELS.fetch(@selected_type) %></h2></div><button type="button" data-close-dialog>×</button></header><ol class="wizard-steps"><% ["Upload","Mapping","Validation","Preview","Dataset & Layer","เสร็จสิ้น"].each_with_index do |label,index| %><li data-step-indicator="<%= index + 1 %>"><i><%= index + 1 %></i><span><%= label %></span></li><% end %></ol>
    <section class="wizard-panel" data-wizard-step="1"><div class="template-banner"><div><b>Template สำหรับ <%= ImportedDataset::TYPE_LABELS.fetch(@selected_type) %></b><small>ดาวน์โหลดโครงสร้างมาตรฐานเพื่อกรอกข้อมูล</small></div><%= link_to "⇩ ดาวน์โหลด Template", dataset_template_path(@selected_type), class: "button-link" %></div><label class="wizard-dropzone">⇧<b>ลากไฟล์มาวาง หรือคลิกเพื่อเลือกไฟล์</b><span>รองรับ CSV · Excel (.xls, .xlsx) · PDF สูงสุด 20 MB</span><input type="file" accept=".csv,.xls,.xlsx,.pdf" data-import-file></label><div class="selected-file" data-selected-file hidden></div></section>
    <section class="wizard-panel" data-wizard-step="2" hidden><div class="panel-heading"><div><h3>จับคู่ Column กับ Field</h3><p>ระบบจับคู่อัตโนมัติ และสามารถแก้ไขเองได้</p></div></div><div class="mapping-list" data-mapping-list></div></section>
    <section class="wizard-panel validation-panel" data-wizard-step="3" hidden><div data-validation-result></div></section>
    <section class="wizard-panel" data-wizard-step="4" hidden><div class="panel-heading"><div><h3>Preview ก่อนนำเข้า</h3><p>ตรวจสอบข้อมูลก่อนบันทึกเป็น Version จริง</p></div></div><div class="preview-table" data-preview-table></div></section>
    <section class="wizard-panel" data-wizard-step="5" hidden><h3>สร้าง Dataset และ Layer</h3><p>เลือกสร้างชุดใหม่ หรืออัปเดตข้อมูลเดิมเป็น Version ใหม่</p><%= render "import_destination_fields", selected_type: @selected_type, editable_datasets: @editable_datasets, subdistricts: @subdistricts %></section>
    <section class="wizard-panel finish-panel" data-wizard-step="6" hidden><div class="finish-check">✓</div><h3>นำเข้าข้อมูลสำเร็จ</h3><p data-finish-message></p><a href="#" class="data-layer-add" data-finish-link>ดู Dataset ที่สร้าง</a></section><p class="modal-status" data-wizard-status></p><footer data-wizard-footer><button type="button" class="button-link" data-wizard-back>ย้อนกลับ</button><span data-step-count>ขั้นตอน 1 จาก 6</span><button type="button" class="data-layer-add" data-wizard-next>ดำเนินการต่อ</button></footer></div></dialog>
<% end %>
<%= javascript_include_tag "dataset_import_wizard", defer: true %>
