<div class="shell dashboard-shell gis-dashboard data-layers-shell">
  <aside class="dashboard-sidebar sidebar">
    <div class="dashboard-brand brand"><span class="brand-symbol">⌂</span><div><strong>SMART CITY</strong><small>GEO ADMINISTRATION PLATFORM</small></div></div>
    <div class="scope-summary"><small>ขอบเขตการดูแล</small><div><b><%= current_user.system_admin? ? "ทุกพื้นที่ทั่วประเทศ" : @area_label %></b></div></div>
    <div class="sidebar-menu-label">เมนูหลัก</div>
    <nav class="primary-nav" aria-label="เมนูหลัก">
      <%= link_to root_path, class: "primary-nav-item", data: { turbo: false } do %><span>⌂</span>ภาพรวมเมือง<% end %>
      <%= link_to area_analysis_path, class: "primary-nav-item", data: { turbo: false } do %><span>⌖</span>การวิเคราะห์แผนที่<% end %>
      <%= link_to disasters_path, class: "primary-nav-item", data: { turbo: false } do %><span>!</span>ภัยพิบัติและเหตุการณ์ <em>3</em><% end %>
      <%= link_to data_layers_path, class: "primary-nav-item active", data: { turbo: false } do %><span>⇧</span>นำเข้าข้อมูล<% end %>
      <% if system_admin? %><%= link_to users_path, class: "primary-nav-item", data: { turbo: false } do %><span>♙</span>จัดการบัญชี<% end %><% end %>
    </nav>
    <div class="sidebar-user user"><div class="avatar"><%= current_user.username.first.upcase %></div><div><b><%= current_user.username %></b><small><%= current_user.role_label %></small></div></div>
    <%= button_to "ออกจากระบบ", destroy_user_session_path, method: :delete, class: "logout" %>
  </aside>
  <main class="dashboard-main content"><header class="dashboard-header gis-topbar"><div><p class="topbar-kicker">SMART GIS PLATFORM</p><span class="breadcrumb"><span>นำเข้าข้อมูล</span><b>›</b><span id="selection-label"><%= @area_label %></span></span></div><button type="button" class="global-search"><span>⌕</span>ค้นหาสถานที่ พิกัด หรือชุดข้อมูล <kbd>⌘ K</kbd></button><div class="header-tools"><div class="longdo-usage"><b>ข้อมูลของฉัน</b><span>พร้อมจัดการ</span></div><div class="header-avatar"><%= current_user.username.first.upcase %></div></div></header>
    <div class="dashboard-content import-hub-content"><section class="city-heading"><div><p class="page-kicker">DATA MANAGEMENT</p><h1>ศูนย์นำเข้าข้อมูล</h1><p>เพิ่มข้อมูลตามหัวข้อที่ระบบรองรับ เพื่อแสดงผลในพื้นที่ที่รับผิดชอบ</p></div><% if @can_upload %><button type="button" class="data-layer-add" data-open-import>＋ นำเข้าข้อมูลใหม่</button><% end %></section>
      <section class="import-intro"><div><b>เลือกประเภทข้อมูลที่ต้องการนำเข้า</b><small>แต่ละหัวข้อมี Template และการตรวจสอบรูปแบบข้อมูลเฉพาะ</small></div></section>
      <section class="import-type-grid"><% types = [["population","♧","ข้อมูลประชากร","ประชากรระดับหมู่บ้านและกลุ่มเปราะบาง","Excel · CSV","พร้อมนำเข้า"],["resources","▤","ข้อมูลทรัพยากร","ครุภัณฑ์ อาคาร และทรัพยากรในพื้นที่","Excel · CSV","เร็ว ๆ นี้"],["sensor","◉","อุปกรณ์และเซนเซอร์","สถานะกล้อง CCTV และอุปกรณ์ตรวจวัด","Excel · CSV","เร็ว ๆ นี้"],["poi","⌖","สถานที่สำคัญ (POI)","สถานที่ จุดบริการ และจุดสนใจเพิ่มเติม","Excel · CSV · KML","เร็ว ๆ นี้"],["boundary","▱","ขอบเขตและข้อมูล GIS","ขอบเขตหมู่บ้าน พื้นที่เสี่ยง และชั้นข้อมูลแผนที่","KML · KMZ · GeoJSON · Shapefile","เร็ว ๆ นี้"]] %><% types.each do |key, icon, name, detail, formats, status| %><button type="button" class="import-type-card <%= 'supported' if key == 'population' %>" data-import-type="<%= key %>" data-import-name="<%= name %>"><span class="import-type-icon"><%= icon %></span><span class="import-type-copy"><b><%= name %></b><small><%= detail %></small><em><%= formats %></em><i><%= status %></i></span><strong>เริ่มนำเข้า →</strong></button><% end %></section>
      <section class="import-history"><div class="section-card-heading"><div><h2>ประวัติการนำเข้าข้อมูล</h2><p>ชุดข้อมูลที่คุณมีสิทธิ์เข้าถึงและจัดการได้</p></div><span><%= @population_datasets.size %> รายการ</span></div><% if @population_datasets.any? %><div class="import-history-table"><div class="import-history-head"><span>ชื่อชุดข้อมูล</span><span>ประเภท</span><span>จำนวนข้อมูล</span><span>ผู้นำเข้า</span><span>อัปเดต</span><span>จัดการ</span></div><% @population_datasets.each do |dataset| %><div class="import-history-row"><div><b><%= dataset.name %></b><small><%= dataset.source_file %> · <%= dataset.subdistrict.name_th %></small></div><span>ข้อมูลประชากร</span><span><%= dataset.records.size %> หมู่บ้าน</span><span><%= dataset.user.username %></span><span><%= dataset.created_at.strftime("%d/%m/%Y %H:%M") %></span><div class="import-history-actions"><%= link_to "ดู", population_dashboard_path(dataset) %><% if @can_upload %><%= button_to "ลบ", population_dataset_path(dataset), method: :delete, class: "dataset-delete", form: { data: { turbo_confirm: "ต้องการลบชุดข้อมูลนี้ใช่หรือไม่?" } } %><% end %></div></div><% end %></div><% else %><div class="data-layer-empty"><span>▤</span><div><b>ยังไม่มีรายการนำเข้า</b><small>เลือกประเภทข้อมูลด้านบนเพื่อเริ่มนำเข้าข้อมูลชุดแรก</small></div></div><% end %></section></div><footer class="dashboard-footer">© <%= Time.current.year %> Smart City Geo Administration Platform</footer></main>
</div>
<dialog class="import-dialog" data-import-dialog><div class="import-dialog-heading"><div><h2 data-dialog-title>นำเข้าข้อมูลใหม่</h2><p data-dialog-subtitle>เลือกไฟล์ข้อมูล</p></div><button type="button" data-close-import>×</button></div><div class="import-steps"><b>1<br><small>เลือกไฟล์</small></b><span></span><b>2<br><small>ตรวจสอบ</small></b><span></span><b>3<br><small>นำเข้า</small></b></div><section class="template-preview-strip"><div><b>Template สำหรับข้อมูลประชากร</b><small>แถวที่ 1 กลุ่มข้อมูล · แถวที่ 2 หัวคอลัมน์ · เริ่มข้อมูลแถวที่ 3</small></div><button type="button" data-download-template>ดาวน์โหลด CSV</button></section><div data-supported-upload><%= form_with url: population_imports_path, multipart: true, class: "modal-upload-form" do %><input type="hidden" name="data_type" value="population"><label class="modal-dropzone" for="modal-population-file"><span>⇧</span><b>ลากไฟล์มาวางที่นี่ หรือคลิกเลือกไฟล์</b><small>รองรับ CSV, XLS และ XLSX</small><input id="modal-population-file" name="file" type="file" accept=".csv,.xls,.xlsx" required hidden></label><p data-modal-file-status>ยังไม่ได้เลือกไฟล์</p><section class="inline-template-preview"><div><b>ตัวอย่างข้อมูลใน Template</b><small>ใช้เป็นแนวทางก่อนอัปโหลด</small></div><div class="template-table-wrap"><table><thead><tr><th>รหัสตำบล</th><th>รหัสหมู่บ้าน</th><th>หมู่ที่</th><th>ชื่อหมู่บ้าน</th><th>อายุ 0–14</th><th>65+</th><th>ผู้ป่วยเรื้อรัง</th><th>ประชากรรวม</th></tr></thead><tbody><tr><td>141407</td><td>14140701</td><td>1</td><td>ตัวอย่างหมู่บ้าน</td><td>120</td><td>46</td><td>12</td><td>640</td></tr></tbody></table></div></section><div class="dialog-actions"><button type="button" data-close-import>ยกเลิก</button><button type="submit" class="data-layer-add">ตรวจสอบและนำเข้า</button></div><% end %></div><div class="import-not-supported" data-not-supported hidden><b>กำลังเตรียมรูปแบบข้อมูลสำหรับหัวข้อนี้</b><p>ขณะนี้ระบบยังไม่เปิดรับข้อมูลประเภทนี้ เพื่อให้การนำเข้าและการแสดงผลถูกต้อง</p><button type="button" data-close-import>ปิด</button></div></dialog>
<script>{const preview=document.querySelector(".inline-template-preview"),card=document.querySelector(".template-preview-strip");card?.querySelector("small")?.remove();preview?.querySelector("div:first-child")?.remove();if(preview&&card)card.append(preview)}</script>
<style>[data-open-import]{display:none!important}.template-preview-strip{flex-wrap:wrap}.inline-template-preview{flex:0 0 100%;padding:4px 0 0}.inline-template-preview .template-table-wrap{margin:9px 0 0;background:#fff;border-color:#d7e2ee}.inline-template-preview .template-table-wrap table{background:#fff}.inline-template-preview .template-table-wrap th{background:#f5f8fc;color:#36536f;font-weight:700}.inline-template-preview .template-table-wrap td{background:#fff;color:#29445f;border-color:#e3eaf1}</style>
<script>(()=>{const dialog=document.querySelector("[data-import-dialog]");const open=type=>{const card=document.querySelector(`[data-import-type="${type}"]`),supported=type==="population";dialog.querySelector("[data-dialog-title]").textContent=`นำเข้า${card?.dataset.importName||"ข้อมูลใหม่"}`;dialog.querySelector("[data-dialog-subtitle]").textContent=supported?"อัปโหลดและตรวจสอบรูปแบบข้อมูล":"หัวข้อนี้กำลังเตรียมการรองรับ";dialog.querySelector("[data-supported-upload]").hidden=!supported;dialog.querySelector("[data-not-supported]").hidden=supported;dialog.showModal()};document.querySelectorAll("[data-open-import]").forEach(x=>x.addEventListener("click",()=>open("population")));document.querySelectorAll("[data-import-type]").forEach(x=>x.addEventListener("click",()=>open(x.dataset.importType)));document.querySelectorAll("[data-close-import]").forEach(x=>x.addEventListener("click",()=>dialog.close()));document.querySelector("#modal-population-file")?.addEventListener("change",e=>{const f=e.currentTarget.files[0];document.querySelector("[data-modal-file-status]").textContent=f?`เลือกไฟล์: ${f.name}`:"ยังไม่ได้เลือกไฟล์"});const download=()=>{const rows=[["ข้อมูลประชากรภายในขอบเขตการดูแล"],["","","","","รหัสตำบล","","รหัสหมู่บ้าน","หมู่ที่","ชื่อหมู่บ้าน","อายุ 0","อายุ 15","อายุ 25","อายุ 55","65+","ผู้ป่วยเรื้อรัง","ผู้ป่วยล้างไต","ผู้ป่วยติดเตียง","ผู้พิการ","ผู้ป่วยจิตเวช","ตั้งครรภ์","ประชากรรวม"],["","","","","141407","","14140701","1","ตัวอย่างหมู่บ้าน","120","70","270","100","46","12","2","1","5","3","4","640"]],csv="\uFEFF"+rows.map(r=>r.map(v=>`\"${String(v).replaceAll('\"','\"\"')}\"`).join(",")).join("\n"),url=URL.createObjectURL(new Blob([csv],{type:"text/csv;charset=utf-8"})),a=document.createElement("a");a.href=url;a.download="population_template.csv";a.click();URL.revokeObjectURL(url)};document.querySelectorAll("[data-download-template]").forEach(x=>x.addEventListener("click",download))})()</script>
