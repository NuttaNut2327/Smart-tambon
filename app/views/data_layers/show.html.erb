<div class="shell dashboard-shell gis-dashboard data-layers-shell">
  <%= render "dashboard/sidebar", active_nav: :data_layers, initial_area: @area_label %>
  <main class="dashboard-main content"><header class="dashboard-header gis-topbar"><div><p class="topbar-kicker">DATA MANAGEMENT</p><span class="breadcrumb"><span id="selection-label"><%= @area_label %></span><b>›</b><span>นำเข้าข้อมูล</span></span></div></header><div class="dashboard-content import-workspace">
    <% if notice %><div class="import-flash success"><%= notice %></div><% end %><% if alert %><div class="import-flash error"><%= alert %></div><% end %>
    <section class="city-heading import-heading"><div><p class="page-kicker">สร้างชุดข้อมูลของตัวเอง</p><h1>นำเข้าข้อมูล</h1><p>จัดการข้อมูลเฉพาะพื้นที่ พร้อมรุ่นข้อมูล ประวัติไฟล์ และชั้นข้อมูลบนแผนที่</p></div><% if @can_upload %><div class="import-heading-actions"><button class="button-link" type="button" data-open-manual>＋ เพิ่มข้อมูลด้วยตนเอง</button><button class="data-layer-add" type="button" data-open-import>⇧ นำเข้าไฟล์</button></div><% end %></section>
    <% current_dataset = @current_dataset_summary&.dig(:dataset); current_version = @current_dataset_summary&.dig(:current_version) %>
    <% geometry_label = current_dataset&.map_enabled? ? ({ "point" => "จุดตำแหน่ง", "line" => "เส้นทาง", "polygon" => "ขอบเขตพื้นที่" }[current_dataset.geometry_type] || current_dataset.geometry_type) : "—" %>
    <div class="data-management-workspace">
      <aside class="dataset-type-nav">
        <h3>ข้อมูลทั่วไปของ อบต.</h3>
        <% [["population", "groups", "ข้อมูลประชากร"], ["agencies", "account_balance", "หน่วยงาน"], ["teams", "group_work", "ทีมปฏิบัติงาน"], ["workforce", "badge", "บุคลากรปฏิบัติงาน"], ["resources", "construction", "ทรัพยากรและอุปกรณ์"], ["consumables", "inventory_2", "วัสดุสิ้นเปลือง"]].each do |key, icon, label| %>
          <%= link_to data_layers_path(data_type: key), class: "dataset-type-link #{'active' if @selected_type == key}" do %>
            <span class="material-symbols-outlined dataset-nav-icon"><%= icon %></span><%= label %><b class="material-symbols-outlined dataset-nav-arrow">chevron_right</b>
          <% end %>
        <% end %>
        <h3>ข้อมูลอุปกรณ์</h3>
        <% [["cctv_devices", "กล้องวงจรปิด"], ["water_level_sensors", "เซนเซอร์วัดระดับน้ำ"], ["pm25_sensors", "เซนเซอร์วัด PM 2.5"]].each do |key, label| %>
          <%= link_to data_layers_path(data_type: key), class: "dataset-type-link #{'active' if @selected_type == key}" do %>
            <span class="material-symbols-outlined dataset-nav-icon"><%= { "cctv_devices" => "videocam", "water_level_sensors" => "water_drop", "pm25_sensors" => "air" }.fetch(key) %></span><%= label %><b class="material-symbols-outlined dataset-nav-arrow">chevron_right</b>
          <% end %>
        <% end %>
        <h3>ชุดข้อมูลแบบกำหนดเอง</h3>
        <%= link_to imported_datasets_path, class: "dataset-type-link custom" do %><span class="material-symbols-outlined dataset-nav-icon">add_box</span>รายการชุดข้อมูล<b class="material-symbols-outlined dataset-nav-arrow">chevron_right</b><% end %>
        <h3>คลังข้อมูลไฟล์</h3>
        <%= link_to data_layers_path(data_type: "file_library"), class: "dataset-type-link" do %><span class="material-symbols-outlined dataset-nav-icon">folder_open</span>คลังข้อมูลไฟล์<b class="material-symbols-outlined dataset-nav-arrow">chevron_right</b><% end %>
      </aside>
      <div class="data-management-main">
        <% if @selected_type == "village_boundaries" %><%= link_to data_layers_path(data_type: "population"), class: "boundary-back-text-link" do %>‹ กลับไปหน้าข้อมูลประชากร<% end %><% end %>
        <nav class="data-management-tabs" aria-label="ส่วนจัดการข้อมูล" role="tablist">
          <button type="button" class="active" role="tab" aria-selected="true" data-data-layer-tab="current"><span class="material-symbols-outlined">table_view</span>ข้อมูลปัจจุบัน</button>
          <% if @selected_type == "consumables" %><button type="button" role="tab" aria-selected="false" data-data-layer-tab="movements"><span class="material-symbols-outlined">swap_vert</span>ประวัติรับเข้า–เบิกออก</button><% end %>
          <button type="button" role="tab" aria-selected="false" data-data-layer-tab="versions"><span class="material-symbols-outlined">history</span>ประวัติรุ่นข้อมูล</button>
          <button type="button" role="tab" aria-selected="false" data-data-layer-tab="audit"><span class="material-symbols-outlined">manage_search</span>ประวัติการแก้ไข</button>
        </nav>
        <section class="import-summary-grid dataset-summary-grid" aria-label="สรุปชุดข้อมูลปัจจุบัน">
          <article><span class="material-symbols-outlined versions">history</span><div><small>รุ่นข้อมูลที่ใช้อยู่</small><strong><%= current_version ? "รุ่นที่ #{current_version.version_number}" : "—" %></strong></div></article>
          <article><span class="material-symbols-outlined records">database</span><div><small>จำนวนข้อมูล</small><strong><%= number_with_delimiter(current_version&.record_count.to_i) %></strong></div></article>
          <article><span class="material-symbols-outlined maps">map</span><div><small>การแสดงบนแผนที่</small><strong class="state <%= current_dataset&.map_enabled? ? 'enabled' : 'disabled' %>"><%= current_dataset&.map_enabled? ? "เปิดใช้งาน" : "ยังไม่เปิดใช้งาน" %></strong></div></article>
          <article><span class="material-symbols-outlined geometry">category</span><div><small>รูปแบบข้อมูลแผนที่</small><strong class="date"><%= geometry_label %></strong></div></article>
          <article><span class="material-symbols-outlined updated">update</span><div><small>อัปเดตล่าสุด</small><strong class="date"><%= current_version ? thai_short_datetime(current_version.created_at) : "—" %></strong></div></article>
        </section>
        <div class="data-management-tab-panel active" role="tabpanel" data-data-layer-tab-panel="current">
      <% if current_dataset %>
        <section class="map-layer-setting-panel current-map-setting"><div><span class="material-symbols-outlined">layers</span><div><b>การตั้งค่าชั้นข้อมูลบนแผนที่</b><p><%= current_dataset.geometry_type == "none" ? "ชุดข้อมูลนี้ยังไม่มีข้อมูลตำแหน่ง จึงยังไม่สามารถแสดงบนแผนที่ได้" : "เมื่อปิด ชื่อชั้นข้อมูลและข้อมูลชุดนี้จะไม่ปรากฏในหน้าแผนที่เมือง" %></p></div></div><% if current_user.can_manage_organization_data?(current_dataset.user_id) %><%= form_with model: current_dataset, method: :patch, class: "map-layer-visibility-form", data: { map_layer_visibility_form: true } do |form| %><label class="map-layer-switch"><%= form.check_box :map_enabled, disabled: current_dataset.geometry_type == "none" %><span aria-hidden="true"></span><em><%= current_dataset.map_enabled? ? "แสดงในชั้นข้อมูล" : "ไม่แสดงในชั้นข้อมูล" %></em></label><% end %><% else %><strong class="map-setting-readonly"><%= current_dataset.map_enabled? ? "เปิดใช้งาน" : "ปิดใช้งาน" %></strong><% end %></section>
      <% end %>
      <section class="dataset-catalog fixed-catalog"><div class="catalog-hero"><div><span>▤</span><div><h2><%= ImportedDataset::TYPE_LABELS.fetch(@selected_type) %></h2><p>โครงสร้างคอลัมน์มาตรฐาน พร้อมนำไปสร้างชั้นข้อมูลบนแผนที่</p></div></div><b><%= @fixed_record_total %> รายการ</b></div><div class="catalog-toolbar"><input type="search" placeholder="ค้นหาข้อมูล" data-fixed-search><span><%= @selected_datasets.size %> ชุดข้อมูล · <%= @fixed_record_total %> รายการ</span></div>
        <div class="fixed-table-wrap"><table class="fixed-data-table"><thead><tr><% @selected_schema.each do |field| %><th><%= field["label"] %></th><% end %><th>อัปเดตล่าสุด</th><th class="record-actions-heading">จัดการ</th></tr></thead><tbody><% @fixed_records.each do |item| %><tr data-fixed-row data-search="<%= item[:record].values.join(' ').downcase %>"><% @selected_schema.each do |field| %><td class="<%= 'stock-low' if @selected_type == 'consumables' && field["key"] == 'current_quantity' && item[:record]["minimum_quantity"].present? && item[:record]["current_quantity"].to_f <= item[:record]["minimum_quantity"].to_f %>"><%= ((@selected_type == "workforce" && field["key"] == "availability_status") || (@selected_type == "teams" && field["key"] == "status") || (@selected_type == "population" && field["key"] == "boundary_status")) ? operational_status_badge(item[:record][field["key"]]) : (item[:record][field["key"]].presence || "—") %><%= " · ใกล้หมด" if @selected_type == "consumables" && field["key"] == "current_quantity" && item[:record]["minimum_quantity"].present? && item[:record]["current_quantity"].to_f <= item[:record]["minimum_quantity"].to_f %></td><% end %><td><span class="fixed-data-date"><%= thai_short_datetime(item[:dataset].updated_at) %></span></td><td class="record-actions"><% if item[:editable] %><% if @selected_type == "consumables" %><button type="button" class="record-icon-button movement" title="รับเข้า–เบิกออก" aria-label="รับเข้า–เบิกออก" data-consumable-movement data-dataset-id="<%= item[:dataset].id %>" data-position="<%= item[:position] %>" data-name="<%= item[:record]["name"] %>" data-unit="<%= item[:record]["unit"] %>" data-quantity="<%= item[:record]["current_quantity"].to_f %>">↕</button><% end %><button type="button" class="record-icon-button edit" title="แก้ไขข้อมูล" aria-label="แก้ไขข้อมูล" data-edit-population data-url="<%= imported_dataset_record_path(item[:dataset], item[:position]) %>" data-record="<%= item[:record].to_json %>">✎</button><button type="button" class="record-icon-button delete" title="ลบข้อมูล" aria-label="ลบข้อมูล" data-delete-population data-url="<%= imported_dataset_record_path(item[:dataset], item[:position]) %>">♲</button><% else %><span class="record-readonly">ดูอย่างเดียว</span><% end %></td></tr><% end %><% if @fixed_records.empty? %><tr class="empty-row"><td colspan="<%= @selected_schema.size + 2 %>">ยังไม่มีข้อมูลประเภทนี้ เริ่มเพิ่มด้วยตนเองหรือนำเข้าไฟล์ได้ทันที</td></tr><% end %></tbody></table></div><% if @fixed_record_total > @fixed_page_size %><nav class="fixed-pagination" aria-label="เปลี่ยนหน้าข้อมูล"><span>แสดง <%= ((@fixed_page - 1) * @fixed_page_size) + 1 %>–<%= [@fixed_page * @fixed_page_size, @fixed_record_total].min %> จาก <%= @fixed_record_total %> รายการ</span><div><%= link_to "‹", data_layers_path(data_type: @selected_type, page: @fixed_page - 1), class: "page-button #{'disabled' if @fixed_page == 1}", aria: { label: "หน้าก่อนหน้า" } %><% (1..@fixed_total_pages).each do |page| %><%= link_to page, data_layers_path(data_type: @selected_type, page: page), class: "page-button #{'active' if page == @fixed_page}" %><% end %><%= link_to "›", data_layers_path(data_type: @selected_type, page: @fixed_page + 1), class: "page-button #{'disabled' if @fixed_page == @fixed_total_pages}", aria: { label: "หน้าถัดไป" } %></div></nav><% end %>
      </section>
    <% if @selected_type == "population" && @fixed_record_total.positive? %>
      <section class="boundary-link-panel"><div><b>ขอบเขตหมู่บ้าน</b><p>ข้อมูลเสริมสำหรับแสดงพื้นที่หมู่บ้านและเชื่อมกับข้อมูลประชากร โดยไม่บังคับว่าต้องมีครบทุกหมู่บ้าน</p><span class="boundary-count linked">เชื่อมแล้ว <%= @linked_population_count %></span><span class="boundary-count pending">ยังไม่เชื่อม <%= @unlinked_population_count %></span></div><%= link_to "ดูข้อมูลขอบเขตหมู่บ้าน", data_layers_path(data_type: "village_boundaries"), class: "data-layer-add boundary-add-link" %></section>
    <% elsif @selected_type == "village_boundaries" %>
      <section class="boundary-link-panel"><div><b>จับคู่ข้อมูลประชากรกับขอบเขตหมู่บ้าน</b><p>ระบบจะใช้รุ่นข้อมูลปัจจุบันของข้อมูลประชากรและขอบเขตหมู่บ้านในพื้นที่เดียวกัน แล้วจับคู่ด้วยรหัสหมู่บ้าน หรือ ตำบล + หมู่ที่</p><span class="boundary-count linked">เชื่อมแล้ว <%= @linked_population_count %></span><span class="boundary-count pending">ยังไม่เชื่อม <%= @unlinked_population_count %></span><% if @boundary_link_stale %><span class="boundary-count stale">ข้อมูลเปลี่ยนแปลง · ต้องจับคู่ใหม่</span><% end %></div><% if @population_datasets.any? && @editable_datasets.any? %><%= button_to(@boundary_link_stale ? "จับคู่ข้อมูลใหม่" : "จับคู่ข้อมูล", link_village_boundaries_path, method: :post, class: "data-layer-add", form_class: "boundary-link-form") %><% else %><span class="boundary-link-empty">เพิ่มขอบเขตอย่างน้อย 1 หมู่บ้านเพื่อเริ่มจับคู่</span><% end %></section>
    <% end %>
    </div>
    <% if @selected_type == "consumables" %>
      <div class="data-management-tab-panel" role="tabpanel" data-data-layer-tab-panel="movements" hidden>
        <section class="consumable-movement-panel">
          <div class="section-card-heading"><div><h2>ประวัติรับเข้า–เบิกออก</h2><p>ติดตามการเปลี่ยนแปลงจำนวนวัสดุ พร้อมหน่วยงานและผู้บันทึก</p></div><span><%= @consumable_movements.size %> รายการล่าสุด</span></div>
          <div class="fixed-table-wrap"><table class="fixed-data-table"><thead><tr><th>วันเวลา</th><th>รายการ</th><th>วัสดุ</th><th>หน่วยงาน</th><th>จำนวน</th><th>ยอดก่อนหน้า</th><th>ยอดคงเหลือ</th><th>ผู้บันทึก</th></tr></thead><tbody>
            <% @consumable_movements.each do |movement| %><tr><td><%= thai_numeric_datetime(movement.created_at) %></td><td><span class="movement-type <%= movement.movement_type %>"><%= movement.type_label %></span></td><td><b><%= movement.consumable_name %></b><small><%= movement.note %></small></td><td><%= movement.agency_name.presence || "—" %></td><td><%= movement.quantity.to_fs(:delimited) %> <%= movement.unit %></td><td><%= movement.quantity_before.to_fs(:delimited) %></td><td><b><%= movement.quantity_after.to_fs(:delimited) %> <%= movement.unit %></b></td><td><%= movement.user&.username || "—" %></td></tr><% end %>
            <% if @consumable_movements.empty? %><tr class="empty-row"><td colspan="8">ยังไม่มีประวัติรับเข้า–เบิกออก</td></tr><% end %>
          </tbody></table></div>
        </section>
      </div>
    <% end %>
    <div class="data-management-tab-panel" role="tabpanel" data-data-layer-tab-panel="versions" hidden>
    <% if @dataset_summaries.any? %>
      <section class="dataset-version-panel">
        <div class="section-card-heading">
          <div><h2>ประวัติรุ่นข้อมูล</h2><p>รุ่นข้อมูลจากไฟล์และรุ่นข้อมูลที่บันทึกไว้เป็นจุดย้อนกลับถาวร หากต้องการเก็บข้อมูลปัจจุบันไว้ดูย้อนหลัง ให้กด “บันทึกเป็นรุ่นข้อมูลปัจจุบัน”</p></div>
          <div class="version-heading-actions">
            <span><%= @version_history.size %> รุ่นข้อมูล</span>
            <% if current_dataset&.current_version&.source_kind == "manual" && current_user.can_manage_organization_data?(current_dataset.user_id) %>
              <%= button_to "บันทึกเป็นรุ่นข้อมูลปัจจุบัน", checkpoint_imported_dataset_versions_path(current_dataset), method: :post, class: "button-link version-save-button", form: { data: { turbo_confirm: "บันทึกข้อมูลปัจจุบันเป็นรุ่นข้อมูลสำหรับดูย้อนหลัง?" } } %>
            <% end %>
          </div>
        </div>
        <div class="version-history-cards">
          <% @version_history.each do |item| %>
            <% dataset = item[:dataset]; version = item[:version] %>
            <article class="version-history-card <%= 'current' if dataset.current_version_id == version.id %>">
              <div class="version-history-top"><span class="version-history-badge">v<%= version.version_number %></span><% if dataset.current_version_id == version.id %><em>ใช้งานอยู่</em><% end %></div>
              <div class="version-name-row">
                <b><%= version.display_name.presence || dataset.name %></b>
                <% if current_user.can_manage_organization_data?(dataset.user_id) %>
                  <details class="version-name-editor">
                    <summary class="material-symbols-outlined" title="แก้ไขชื่อรุ่นข้อมูล" aria-label="แก้ไขชื่อรุ่นข้อมูล">edit</summary>
                    <%= form_with model: version, url: imported_dataset_version_path(dataset, version), method: :patch do |form| %>
                      <%= form.text_field :display_name, value: version.display_name.presence || dataset.name, required: true, maxlength: 120, aria: { label: "ชื่อรุ่นข้อมูล #{version.version_number}" } %>
                      <%= form.submit "บันทึก", class: "table-action" %>
                    <% end %>
                  </details>
                <% end %>
              </div>
              <p><%= version.change_note.presence || (version.source_kind == 'manual' ? 'เพิ่มหรือแก้ไขข้อมูลด้วยตนเอง' : 'นำเข้าข้อมูลจากไฟล์') %></p>
              <small><%= version.record_count %> รายการ · <%= thai_numeric_datetime(version.created_at) %></small>
              <div><%= link_to "ดูข้อมูล", imported_dataset_version_path(dataset, version), class: "table-action", data: { version_preview_url: imported_dataset_version_path(dataset, version) } %><%= link_to "ดาวน์โหลดไฟล์", download_imported_dataset_version_path(dataset, version), class: "table-action" if version.downloadable? %></div>
            </article>
          <% end %>
        </div>
      </section>
    <% else %>
      <section class="data-tab-empty"><span class="material-symbols-outlined">history</span><h2>ยังไม่มีประวัติรุ่นข้อมูล</h2><p>เมื่อเพิ่มข้อมูลหรือนำเข้าไฟล์ ประวัติรุ่นข้อมูลจะแสดงที่นี่</p></section>
    <% end %>
    </div>
    <div class="data-management-tab-panel" role="tabpanel" data-data-layer-tab-panel="audit" hidden>
    <% if @change_logs.any? %>
      <% audit_action_labels = { "add" => "เพิ่ม", "update" => "แก้ไข", "delete" => "ลบ", "import" => "นำเข้าไฟล์", "restore" => "กู้คืน", "checkpoint" => "บันทึกเป็นรุ่นข้อมูล" } %>
      <% audit_field_labels = @form_schema.to_h { |field| [field["key"], field["label"]] } %>
      <section class="dataset-audit-panel">
        <div class="section-card-heading"><div><h2>ประวัติการแก้ไข</h2><p>ตรวจสอบย้อนหลังว่าใครเพิ่ม แก้ไข ลบ หรือนำเข้าข้อมูล</p></div><span><%= @change_logs.size %> รายการล่าสุด</span></div>
        <div class="dataset-audit-table-wrap">
          <table class="dataset-audit-table">
            <thead><tr><th>วันและเวลา</th><th>การดำเนินการ</th><th>รายการข้อมูล</th><th>ผู้ดำเนินการ</th><th>การเปลี่ยนแปลง</th></tr></thead>
            <tbody>
              <% @change_logs.each do |log| %>
                <% change_summary = case log.action
                   when "add" then "เพิ่มข้อมูลใหม่ 1 รายการ"
                   when "delete" then "ลบข้อมูล 1 รายการ"
                   when "update" then "แก้ไข #{log.changed_fields.size} ช่องข้อมูล"
                   else log.note.presence || "ข้อมูลทั้งชุด"
                   end %>
                <tr>
                  <td class="audit-date"><%= thai_short_datetime(log.created_at) %></td>
                  <td><span class="audit-action <%= log.action %>"><%= audit_action_labels.fetch(log.action, log.action) %></span></td>
                  <td class="audit-record"><b><%= log.record_label.presence || log.note.presence || ImportedDataset::TYPE_LABELS.fetch(@selected_type) %></b><small><%= change_summary %></small></td>
                  <td class="audit-user"><span class="material-symbols-outlined">person</span><%= log.user&.username || "—" %></td>
                  <td><button type="button" class="dataset-audit-toggle" data-audit-toggle="audit-detail-<%= log.id %>" aria-expanded="false" aria-controls="audit-detail-<%= log.id %>">ดูรายละเอียด <i class="material-symbols-outlined">expand_more</i></button></td>
                </tr>
                <tr id="audit-detail-<%= log.id %>" class="dataset-audit-detail-row" hidden>
                  <td colspan="5">
                    <div class="dataset-audit-detail">
                        <% if %w[add delete].include?(log.action) %>
                          <div class="audit-record-summary <%= log.action %>"><span class="material-symbols-outlined"><%= log.action == "add" ? "add_circle" : "delete" %></span><div><b><%= change_summary %></b><small><%= log.record_label.presence || ImportedDataset::TYPE_LABELS.fetch(@selected_type) %> · มีข้อมูล <%= log.changed_fields.size %> ช่อง</small></div></div>
                        <% elsif log.changed_fields.any? %>
                          <% log.changed_fields.each do |field| %><p><b><%= audit_field_labels[field] || field %></b><span><small>ข้อมูลเดิม</small><em><%= log.before_data[field].presence || "—" %></em></span><i class="material-symbols-outlined">arrow_forward</i><strong><small>ข้อมูลใหม่</small><em><%= log.after_data[field].presence || "—" %></em></strong></p><% end %>
                        <% else %>
                          <p><b>จำนวนข้อมูล</b><span><small>ข้อมูลเดิม</small><em><%= log.before_data["record_count"].to_i %> รายการ</em></span><i class="material-symbols-outlined">arrow_forward</i><strong><small>ข้อมูลใหม่</small><em><%= log.after_data["record_count"].to_i %> รายการ</em></strong></p>
                        <% end %>
                        <% if log.note.present? %><small>หมายเหตุ: <%= log.note %></small><% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% else %>
      <section class="data-tab-empty"><span class="material-symbols-outlined">manage_search</span><h2>ยังไม่มีประวัติการแก้ไข</h2><p>รายการเพิ่ม แก้ไข ลบ และนำเข้าข้อมูลจะแสดงที่นี่</p></section>
    <% end %>
    </div>
      </div>
    </div>
  </div></main>
</div>

<% if @can_upload %>
	<% if @selected_type == "consumables" %>
	  <dialog class="dataset-modal" id="consumable-movement-dialog"><form method="post" action="<%= consumable_movements_path %>"><input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>"><input type="hidden" name="imported_dataset_id" data-movement-dataset><input type="hidden" name="record_position" data-movement-position><header><div><small>ติดตามจำนวนวัสดุ</small><h2 data-movement-title>บันทึกความเคลื่อนไหว</h2></div><button type="button" data-close-dialog>×</button></header><div class="modal-info" data-movement-balance></div><div class="manual-fixed-grid"><label>ประเภทรายการ *<select name="movement_type" required><option value="receive">รับเข้า</option><option value="issue">เบิกออก</option><option value="return">คืนเข้า</option><option value="adjustment">ปรับยอดจากการตรวจนับ</option></select></label><label>จำนวน *<input name="quantity" type="number" min="0" step="any" required></label><label>รหัสเหตุการณ์<input name="incident_reference" placeholder="ระบุเมื่อเบิกใช้กับเหตุการณ์"></label><label>หมายเหตุ<input name="note" placeholder="รายละเอียดเพิ่มเติม"></label></div><footer><button type="button" class="button-link" data-close-dialog>ยกเลิก</button><button class="data-layer-add" type="submit">บันทึกความเคลื่อนไหว</button></footer></form></dialog>
	<% end %>
  <dialog class="dataset-modal" id="manual-data-dialog"><form id="manual-data-form"><header><div><small>เพิ่มข้อมูลแบบกรอกตรง</small><h2>เพิ่ม<%= ImportedDataset::TYPE_LABELS.fetch(@selected_type) %>ด้วยตนเอง</h2></div><button type="button" data-close-dialog>×</button></header><div class="modal-info">กรอกข้อมูลตามคอลัมน์มาตรฐาน ช่องที่มีเครื่องหมาย * จำเป็นต้องกรอก</div><div class="manual-fixed-grid"><% @form_schema.reject { |field| field["generated"] || field["hidden"] }.each do |field| %><label><%= field["label"] %><%= " *" if field["required"] %><% if @selected_type == "resources" && field["key"] == "responsible_person" %><select name="record[responsible_person]" data-agency-select required><option value="">เลือกหน่วยงานผู้รับผิดชอบ</option><%= options_for_select(@agency_options.map(&:first)) %></select><% elsif %w[workforce teams consumables].include?(@selected_type) && field["key"] == "agency_name" %><select name="record[agency_name]" data-agency-select required><option value="">เลือกหน่วยงาน</option><%= options_for_select(@agency_options.map(&:first)) %></select><% elsif @selected_type == "workforce" && field["key"] == "team_name" %><select name="record[team_name]" data-team-select><option value="">เลือกทีมปฏิบัติงาน</option><%= options_for_select(@team_options.map(&:first)) %></select><% elsif @selected_type == "resources" && field["key"] == "status" %><select name="record[status]" required><%= options_for_select(["พร้อมใช้", "กำลังใช้งาน", "ซ่อมบำรุง", "ชำรุด", "ปลดระวาง"], "พร้อมใช้") %></select><% elsif @selected_type == "workforce" && field["key"] == "employment_status" %><select name="record[employment_status]" required><%= options_for_select(["ปฏิบัติงาน", "ลา", "พักงาน", "พ้นสภาพ"], "ปฏิบัติงาน") %></select><% elsif @selected_type == "workforce" && field["key"] == "availability_status" %><select name="record[availability_status]" required><%= options_for_select(["พร้อมปฏิบัติงาน", "ติดภารกิจ", "ไม่พร้อมปฏิบัติงาน"], "พร้อมปฏิบัติงาน") %></select><% elsif @selected_type == "teams" && field["key"] == "status" %><select name="record[status]" required><%= options_for_select(["พร้อมปฏิบัติงาน", "ติดภารกิจ", "ไม่พร้อมปฏิบัติงาน"], "พร้อมปฏิบัติงาน") %></select><% else %><input name="record[<%= field['key'] %>]" type="<%= field['type'] == 'number' ? 'number' : field['type'] == 'date' ? 'date' : 'text' %>" <%= "required" if field["required"] %> step="any"><% end %></label><% end %><% @form_schema.select { |field| field["hidden"] }.each do |field| %><input type="hidden" name="record[<%= field['key'] %>]" <%= "required" if field["required"] %>><% end %></div><%= render "import_destination_fields", selected_type: @selected_type, editable_datasets: @editable_datasets, subdistricts: @subdistricts, show_version_name: false, manual_entry: true %><input type="hidden" name="data_type" value="<%= @selected_type %>"><script type="application/json" data-agency-options><%= raw json_escape(@agency_options.map { |name, code| { name: name, code: code } }.to_json) %></script><script type="application/json" data-team-options><%= raw json_escape(@team_options.map { |name, code| { name: name, code: code } }.to_json) %></script><p class="modal-status" data-manual-status></p><footer><button type="button" class="button-link" data-close-dialog>ยกเลิก</button><button class="data-layer-add" type="submit">บันทึกและเพิ่มในรายการ</button></footer></form></dialog>
  <dialog class="dataset-modal" id="edit-population-dialog"><form id="edit-population-form"><header><div><small>แก้ไข<%= ImportedDataset::TYPE_LABELS.fetch(@selected_type) %></small><h2>แก้ไขรายการ</h2></div><button type="button" data-close-dialog>×</button></header><div class="modal-info">ระบบจะอัปเดตรุ่นข้อมูลที่กรอกเองล่าสุด หากข้อมูลปัจจุบันมาจากไฟล์ ระบบจะสร้างรุ่นข้อมูลสำหรับการแก้ไขขึ้นใหม่</div><div class="manual-fixed-grid"><% @form_schema.reject { |field| field["generated"] || field["hidden"] }.each do |field| %><label><%= field["label"] %><%= " *" if field["required"] %><% if @selected_type == "workforce" && field["key"] == "employment_status" %><select name="record[employment_status]" data-edit-field="employment_status" required><%= options_for_select(["ปฏิบัติงาน", "ลา", "พักงาน", "พ้นสภาพ"]) %></select><% elsif @selected_type == "workforce" && field["key"] == "availability_status" %><select name="record[availability_status]" data-edit-field="availability_status" required><%= options_for_select(["พร้อมปฏิบัติงาน", "ติดภารกิจ", "ไม่พร้อมปฏิบัติงาน"]) %></select><% else %><input name="record[<%= field['key'] %>]" data-edit-field="<%= field['key'] %>" type="<%= %w[number integer].include?(field['type']) ? 'number' : 'text' %>" <%= "required" if field["required"] %> <%= "readonly" if @selected_type == "consumables" && field["key"] == "current_quantity" %> step="any"><% end %></label><% end %><% @form_schema.select { |field| field["hidden"] }.each do |field| %><input type="hidden" name="record[<%= field['key'] %>]" data-edit-field="<%= field['key'] %>" <%= "required" if field["required"] %>><% end %></div><label class="record-change-note">รายละเอียดการแก้ไข<input name="change_note" placeholder="ระบุรายละเอียดที่แก้ไข"></label><p class="modal-status" data-edit-status></p><footer><button type="button" class="button-link" data-close-dialog>ยกเลิก</button><button class="data-layer-add" type="submit">บันทึกการแก้ไข</button></footer></form></dialog>
  <dialog class="dataset-modal import-wizard-modal" id="file-import-dialog" data-selected-type="<%= @selected_type %>"><div class="wizard-shell"><header><div><small>นำเข้าชุดข้อมูลตามระบบ</small><h2>นำเข้า<%= ImportedDataset::TYPE_LABELS.fetch(@selected_type) %></h2></div><button type="button" data-close-dialog>×</button></header><ol class="wizard-steps"><% ["อัปโหลด","จับคู่ข้อมูล","ตรวจสอบ","ตัวอย่างข้อมูล","รุ่นข้อมูลและชั้นข้อมูล","เสร็จสิ้น"].each_with_index do |label,index| %><li data-step-indicator="<%= index + 1 %>"><i><%= index + 1 %></i><span><%= label %></span></li><% end %></ol>
    <section class="wizard-panel" data-wizard-step="1"><div class="template-banner"><div><b>Template สำหรับ <%= ImportedDataset::TYPE_LABELS.fetch(@selected_type) %></b><small>ดาวน์โหลดโครงสร้างมาตรฐานเพื่อกรอกข้อมูล</small></div><%= link_to "⇩ ดาวน์โหลด Template", dataset_template_path(@selected_type), class: "button-link" %></div><label class="wizard-dropzone">⇧<b>ลากไฟล์มาวาง หรือคลิกเพื่อเลือกไฟล์</b><span>รองรับ CSV · Excel (.xls, .xlsx) · PDF สูงสุด 20 MB</span><input type="file" accept=".csv,.xls,.xlsx,.pdf" data-import-file></label><div class="selected-file" data-selected-file hidden></div></section>
    <section class="wizard-panel" data-wizard-step="2" hidden><div class="panel-heading"><div><h3>จับคู่ Column กับ Field</h3><p>ระบบจับคู่อัตโนมัติ และสามารถแก้ไขเองได้</p></div></div><div class="mapping-list" data-mapping-list></div></section>
    <section class="wizard-panel validation-panel" data-wizard-step="3" hidden><div data-validation-result></div></section>
    <section class="wizard-panel" data-wizard-step="4" hidden><div class="panel-heading"><div><h3>ตัวอย่างก่อนนำเข้า</h3><p>ตรวจสอบข้อมูลก่อนบันทึกเป็นรุ่นข้อมูลจริง</p></div></div><div class="preview-table" data-preview-table></div></section>
    <section class="wizard-panel" data-wizard-step="5" hidden><h3>บันทึกเป็นรุ่นข้อมูลใหม่</h3><p>ระบบจะเลือกชุดข้อมูลหลักของพื้นที่ให้อัตโนมัติ</p><%= render "import_destination_fields", selected_type: @selected_type, editable_datasets: @editable_datasets, subdistricts: @subdistricts %></section>
    <section class="wizard-panel finish-panel" data-wizard-step="6" hidden><div class="finish-check">✓</div><h3>นำเข้าข้อมูลสำเร็จ</h3><p data-finish-message></p><a href="#" class="data-layer-add" data-finish-link>ดูข้อมูลที่นำเข้า</a></section><p class="modal-status" data-wizard-status></p><footer data-wizard-footer><button type="button" class="button-link" data-wizard-back>ย้อนกลับ</button><span data-step-count>ขั้นตอน 1 จาก 6</span><button type="button" class="data-layer-add" data-wizard-next>ดำเนินการต่อ</button></footer></div></dialog>
<% end %>
<%= javascript_include_tag "dataset_import_wizard", defer: true %>
