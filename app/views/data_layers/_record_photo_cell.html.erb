<% cover = photos.first %>
<td class="record-photo-cell">
  <button type="button" class="record-photo-thumb<%= ' empty' unless cover %>" data-record-photos
          data-name="<%= record["name"] %>" data-editable="<%= editable %>"
          data-upload-url="<%= imported_dataset_record_photos_path(dataset, record["record_id"]) if record["record_id"].present? %>"
          data-photos="<%= photos.map { |photo| dataset_record_photo_json(dataset, photo) }.to_json %>"
          title="<%= cover ? "ดูภาพ (#{photos.size})" : (editable ? "แนบภาพ" : "ไม่มีภาพ") %>" <%= "disabled" unless cover || editable %>>
    <% if cover %>
      <img src="<%= imported_dataset_record_photo_path(dataset, cover.record_id, cover, variant: "thumb") %>" alt="" loading="lazy">
      <% if photos.size > 1 %><span class="record-photo-count"><%= photos.size %></span><% end %>
    <% else %>
      <span class="material-symbols-outlined" aria-hidden="true"><%= editable ? "add_a_photo" : "image" %></span>
    <% end %>
  </button>
</td>
