<div class="destination-fields" data-destination-fields><label>ปลายทางข้อมูล<select name="target_dataset_id" data-target-dataset><option value="">สร้าง Dataset ใหม่</option><% editable_datasets.each do |dataset| %><option value="<%= dataset.id %>"><%= dataset.name %> (v<%= dataset.current_version&.version_number || 0 %>)</option><% end %></select></label><label data-new-dataset-field>ชื่อ Dataset<input name="dataset_name" value="<%= ImportedDataset::TYPE_LABELS.fetch(selected_type) %> <%= Date.current.strftime('%d-%m-%Y') %>" required></label><label data-new-dataset-field>พื้นที่<select name="subdistrict_id" <%= "required" unless current_user.system_admin? %>><option value="">เลือกพื้นที่</option><% subdistricts.each do |subdistrict| %><option value="<%= subdistrict.id %>" <%= "selected" if subdistrict.id == current_user.subdistrict_id %>><%= subdistrict.name_th %><%= " · #{subdistrict.province.name_th}" if subdistrict.province %></option><% end %></select></label><% if selected_type != "population" %><label class="map-option"><input type="checkbox" name="map_enabled" value="1"> สร้าง/อัปเดตเป็นชั้นข้อมูลบนแผนที่ <small>ต้องมีละติจูดและลองจิจูด</small></label><% else %><div class="map-option map-option-note">ข้อมูลประชากรชุดนี้ไม่มีพิกัดรายแถว จึงจัดเก็บตามหมู่บ้าน/พื้นที่โดยไม่สร้าง Layer แบบจุด</div><% end %><label>รายละเอียด Version<input name="change_note" placeholder="เช่น นำเข้าข้อมูลเดือนกันยายน 2569"></label></div>
