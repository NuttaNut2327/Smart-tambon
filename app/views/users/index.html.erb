<main class="users-page">
  <header><div><h1>จัดการผู้ใช้</h1><p><%= current_user.system_admin? ? "จัดการบัญชีและขอบเขตพื้นที่ของทุกหน่วยงาน" : "จัดการบัญชีผู้ดูแลและเจ้าหน้าที่ภายใน อบต. ของคุณ" %></p></div><%= link_to "กลับหน้าหลัก", root_path, class: "button-link" %></header>
  <section class="users-card">
    <div class="users-toolbar"><h2>ผู้ใช้งาน</h2><%= link_to "เพิ่มผู้ใช้", new_user_path, class: "button-link primary" %></div>
    <table><thead><tr><th>ชื่อผู้ใช้งาน</th><th>สิทธิ์</th><th>พื้นที่/หน่วยงาน</th><th>จัดการ</th></tr></thead><tbody>
      <% @users.each do |user| %><tr><td><b><%= user.username %></b><%= tag.small("บัญชีที่กำลังใช้งาน", class: "current-account-label") if user == current_user %></td><td><%= user.role_label %></td><td><%= user.access_area&.name.presence || (user.subdistrict ? "#{user.subdistrict.name_th}, #{user.subdistrict.province.name_th}" : "ทุกพื้นที่") %></td><td class="user-actions"><%= link_to "แก้ไข", edit_user_path(user), class: "user-edit" %><% unless user == current_user %><%= button_to "ลบ", user_path(user), method: :delete, class: "user-delete", form: { data: { delete_user_form: true, username: user.username } } %><% end %></td></tr><% end %>
    </tbody></table>
  </section>
  <dialog class="delete-user-dialog" data-delete-user-dialog aria-labelledby="delete-user-title">
    <h2 id="delete-user-title">ยืนยันการลบบัญชี</h2>
    <p>ต้องการลบบัญชี <strong data-delete-user-name></strong> ใช่หรือไม่?</p>
    <small>การกระทำนี้ไม่สามารถย้อนกลับได้</small>
    <form method="post" data-delete-user-confirm-form>
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <input type="hidden" name="_method" value="delete">
      <div class="delete-user-dialog-actions"><button type="button" class="button-link" data-delete-user-cancel>ยกเลิก</button><button type="submit" class="delete-user-confirm">ลบบัญชี</button></div>
    </form>
  </dialog>
</main>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const dialog = document.querySelector("[data-delete-user-dialog]");
    const confirmForm = document.querySelector("[data-delete-user-confirm-form]");
    const userName = document.querySelector("[data-delete-user-name]");
    if (!dialog || !confirmForm || !userName) return;
    document.querySelectorAll("[data-delete-user-form]").forEach(form => form.addEventListener("submit", event => {
      event.preventDefault();
      confirmForm.action = form.action;
      userName.textContent = form.dataset.username;
      dialog.showModal();
    }));
    document.querySelector("[data-delete-user-cancel]")?.addEventListener("click", () => dialog.close());
  });
</script>
