<% org = @organization_setting %>
<% logo_src = org&.logo.present? ? logo_organization_settings_path(key: org.organization_key, v: org.logo["id"]) : system_logo_src %>
<header class="public-report-header">
  <div class="public-report-brand"><%= image_tag logo_src, class: "smart-tambon-logo public-brand-logo", alt: "" %><div><strong><%= org&.display_name(@report_area_name) || @report_area_name || system_name %></strong><small>แบบฟอร์มแจ้งเหตุสำหรับ<%= @report_source_name %></small></div></div>
  <span class="public-report-secure"><span class="material-symbols-outlined">lock</span>แบบฟอร์มสำหรับ<%= @report_source_name %></span>
</header>
