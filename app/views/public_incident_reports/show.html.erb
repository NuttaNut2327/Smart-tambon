<% liff_path = liff_public_incident_report_path(token: params[:token]) %>
<% connect_url = @line_setting.citizen_liff_url(liff_path) %>
<main class="public-report-page" data-public-report-page data-reverse-geocode-url="<%= reverse_geocode_public_incident_report_path(token: params[:token]) %>" data-similar-incidents-url="<%= similar_incidents_public_incident_report_path(token: params[:token]) %>" data-confirm-similar-url-template="<%= confirm_similar_incident_public_incident_report_path(token: params[:token], incident_id: "INCIDENT_ID") %>" data-liff-mode="<%= @liff_mode %>" data-liff-id="<%= @line_setting.citizen_line_liff_id if @liff_mode %>" data-connect-line-url="<%= connect_url unless @liff_mode %>" data-report-token="<%= params[:token] %>">
  <script type="application/json" data-public-boundary><%= raw json_escape(@report_boundary_feature.to_json) %></script>
  <script type="application/json" data-public-important-places><%= raw json_escape(@important_places.to_json) %></script>
  <%= render "public_incident_reports/header" %>

  <div class="public-report-container">
    <% if @liff_mode %><section class="public-report-welcome" data-line-identity-status><span class="material-symbols-outlined">sync</span><p>กำลังเชื่อมต่อบัญชี LINE เพื่อรับการแจ้งสถานะ…</p></section><% elsif connect_url %><section class="public-report-welcome public-line-connect-banner"><span class="material-symbols-outlined">notifications</span><p>ต้องการรับสถานะเรื่องที่แจ้งทาง LINE หรือไม่?</p><%= link_to "เชื่อมต่อ LINE", connect_url, class: "public-report-again" %></section><% end %>
    <section class="public-report-intro"><div><p>แจ้งเหตุในพื้นที่</p><h1>แบบฟอร์มแจ้งเหตุภายในพื้นที่ <%= @report_area_name %></h1><p>กรอกข้อมูลและปักตำแหน่งภายในขอบเขตพื้นที่ <%= @report_area_name %> เจ้าหน้าที่จะตรวจสอบและรับเรื่องโดยเร็วที่สุด</p></div></section>

    <% if @organization_setting&.public_report_welcome.present? %><section class="public-report-welcome"><span class="material-symbols-outlined">campaign</span><p><%= simple_format(@organization_setting.public_report_welcome, {}, wrapper_tag: "span") %></p></section><% end %>
    <% organization = @organization_setting %>
    <% if organization && [organization.organization_name, organization.executive_name, organization.address, organization.phone, organization.email, organization.website].any?(&:present?) %>
      <section class="public-report-organization" aria-labelledby="public-report-organization-title">
        <div class="public-report-organization-heading"><span class="material-symbols-outlined">account_balance</span><div><p>หน่วยงานผู้รับแจ้งเหตุ</p><h2 id="public-report-organization-title"><%= organization.display_name(@report_area_name) %></h2></div></div>
        <dl class="public-report-organization-grid">
          <% if organization.executive_name.present? %><div><dt><span class="material-symbols-outlined">person</span>ผู้บริหาร/นายก อบต.</dt><dd><%= organization.executive_name %></dd></div><% end %>
          <% if organization.website.present? %><div><dt><span class="material-symbols-outlined">language</span>เว็บไซต์</dt><dd><%= link_to organization.website, organization.website, target: "_blank", rel: "noopener noreferrer" %></dd></div><% end %>
          <% if organization.phone.present? %><div><dt><span class="material-symbols-outlined">call</span>โทรศัพท์</dt><dd><%= link_to organization.phone, "tel:#{organization.phone.gsub(/[^\d+]/, '')}" %></dd></div><% end %>
          <% if organization.email.present? %><div><dt><span class="material-symbols-outlined">mail</span>อีเมล</dt><dd><%= mail_to organization.email %></dd></div><% end %>
          <% if organization.address.present? %><div class="wide"><dt><span class="material-symbols-outlined">location_on</span>ที่อยู่</dt><dd><%= simple_format(organization.address, {}, wrapper_tag: "span") %></dd></div><% end %>
        </dl>
      </section>
    <% end %>
    <% if @incident.errors.any? %><div class="public-report-errors"><strong>กรุณาตรวจสอบข้อมูล</strong><ul><% @incident.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>

    <%= form_with model: @incident, url: (@liff_mode ? liff_public_incident_report_path(token: params[:token]) : public_incident_report_path(token: params[:token])), method: :post, local: true, html: { class: "public-report-form", multipart: true } do |form| %>
      <input type="text" name="website" class="public-report-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
      <% if @liff_mode %><%= hidden_field_tag :line_id_token, params[:line_id_token], data: { line_id_token: true } %><% end %>
      <section class="public-report-card">
        <div class="public-report-card-title"><span>1</span><div><h2>ข้อมูลเหตุการณ์</h2><p>ระบุข้อมูลที่ช่วยให้เจ้าหน้าที่เข้าใจสถานการณ์</p></div></div>
        <div class="public-report-grid">
          <div class="wide public-report-area"><small>พื้นที่เกิดเหตุ</small><strong><%= @report_area_name %></strong></div>
          <label class="wide"><span class="public-required-label"><b>*</b> ชื่อเหตุการณ์</span><%= form.text_field :title, required: true, maxlength: 150, placeholder: "เช่น ต้นไม้ล้มกีดขวางถนน" %></label>
          <label><span class="public-required-label"><b>*</b> ประเภทเหตุการณ์</span><span class="public-custom-select <%= 'is-empty' if @incident.incident_type.blank? %>" data-public-custom-select data-public-select-placeholder data-empty="<%= @incident.incident_type.blank? %>"><%= form.select :incident_type, Incident::DISASTER_INCIDENT_TYPES, { selected: @incident.incident_type, include_blank: false }, data: { incident_type_select: true } %><button type="button" data-public-custom-select-trigger aria-haspopup="listbox" aria-expanded="false"><span><%= @incident.incident_type.presence || "เลือกประเภทเหตุการณ์" %></span></button><span class="public-custom-select-menu" data-public-custom-select-menu role="listbox" hidden><% Incident::DISASTER_INCIDENT_TYPES.each do |type| %><button type="button" role="option" data-value="<%= type %>" aria-selected="<%= @incident.incident_type == type %>"><%= type %></button><% end %></span></span></label>
          <% severity_options = [["วิกฤต", "critical"], ["เร่งด่วนมาก", "very_urgent"], ["เร่งด่วน", "urgent"], ["ไม่เร่งด่วน", "non_urgent"], ["ทั่วไป", "general"]] %>
          <label><span class="public-required-label"><b>*</b> ระดับความเร่งด่วน</span><span class="public-custom-select <%= 'is-empty' if @incident.severity.blank? %>" data-public-custom-select data-public-severity-placeholder data-empty="<%= @incident.severity.blank? %>"><%= form.select :severity, severity_options, { selected: @incident.severity, include_blank: false }, data: { public_severity_select: true } %><button type="button" data-public-custom-select-trigger aria-haspopup="listbox" aria-expanded="false"><span><%= severity_options.to_h.key(@incident.severity) || "เลือกระดับความเร่งด่วน" %></span></button><span class="public-custom-select-menu" data-public-custom-select-menu role="listbox" hidden><% severity_options.each do |label, value| %><button type="button" role="option" data-value="<%= value %>" aria-selected="<%= @incident.severity == value %>"><%= label %></button><% end %></span></span></label>
          <label class="wide" data-incident-type-other <%= "hidden" unless @incident.incident_type == "อื่น ๆ" %>><span class="public-required-label"><b>*</b> ระบุประเภทเหตุการณ์อื่น ๆ</span><%= form.text_field :incident_type_other, required: @incident.incident_type == "อื่น ๆ", disabled: @incident.incident_type != "อื่น ๆ", maxlength: 100, placeholder: "เช่น ถนนชำรุด ไฟฟ้าขัดข้อง หรืออุบัติเหตุ", data: { incident_type_other_input: true } %></label>
          <label class="wide"><span class="public-required-label"><b>*</b> รายละเอียดเหตุการณ์</span><%= form.text_area :description, required: true, rows: 5, maxlength: 2000, placeholder: "อธิบายสิ่งที่เกิดขึ้นและสภาพเหตุการณ์ปัจจุบัน" %></label>
          <label class="wide">ผลกระทบเบื้องต้น<%= form.text_area :initial_impact, rows: 3, maxlength: 1000, placeholder: "เช่น การจราจรติดขัด บ้านเรือนได้รับความเสียหาย" %></label>
          <label class="wide public-report-photo-field"><span>รูปภาพประกอบเหตุการณ์</span><span class="public-photo-upload-control"><span class="public-photo-upload-icon material-symbols-outlined">add_photo_alternate</span><span class="public-photo-upload-copy"><b>เลือกรูปภาพ</b><small>กดเพื่อเลือกรูปจากอุปกรณ์</small></span><span class="public-photo-upload-action">เพิ่มรูป</span><%= form.file_field :photos, multiple: true, accept: "image/jpeg,image/png,image/webp", data: { public_photo_input: true } %></span><small>เลือกเพิ่มได้หลายครั้ง สูงสุด 8 รูป รองรับ JPG, PNG และ WebP ขนาดไม่เกิน 10 MB ต่อรูป</small><span class="public-photo-message" data-public-photo-message></span></label>
          <div class="wide public-photo-preview" data-public-photo-preview hidden></div>
        </div>
      </section>

      <section class="public-report-card">
        <div class="public-report-card-title"><span>2</span><div><h2><span class="public-required-label"><b>*</b> ตำแหน่งที่เกิดเหตุ</span></h2><p>แตะบนแผนที่หรือใช้ตำแหน่งปัจจุบัน</p></div></div>
        <button type="button" class="public-report-location-button" data-public-use-location><span class="material-symbols-outlined">my_location</span>ใช้ตำแหน่งปัจจุบัน</button>
        <div class="public-report-map" data-public-report-map data-latitude="<%= @incident.latitude %>" data-longitude="<%= @incident.longitude %>"></div>
        <div class="public-report-map-legend"><span><i class="boundary"></i>ขอบเขตพื้นที่รับแจ้ง</span><span><i class="place"></i>สถานที่สำคัญ</span></div>
        <p class="public-report-coordinate" data-public-coordinate><%= @incident.latitude.present? ? "#{@incident.latitude}, #{@incident.longitude}" : "ยังไม่ได้ปักหมุด — แตะบนแผนที่เพื่อเลือกตำแหน่ง" %></p>
        <p class="public-report-address" data-public-address><%= @incident.location_name.presence || "เมื่อปักหมุด ระบบจะแสดงที่อยู่โดยประมาณตรงนี้" %></p>
        <section class="public-similar-incidents" data-public-similar-incidents hidden aria-live="polite"></section>
        <%= form.hidden_field :latitude, data: { public_latitude: true } %>
        <%= form.hidden_field :longitude, data: { public_longitude: true } %>
        <%= form.hidden_field :location_name, value: @incident.location_name, data: { public_location_name: true } %>
      </section>

      <section class="public-report-card">
        <div class="public-report-card-title"><span>3</span><div><h2>ข้อมูลผู้แจ้ง</h2><p>ใช้สำหรับติดต่อสอบถามข้อมูลเพิ่มเติมเท่านั้น</p></div></div>
        <div class="public-report-grid">
          <div class="wide public-report-area"><small>ช่องทางรับแจ้ง</small><strong>แจ้งเหตุโดย <%= @report_source_name %></strong></div>
          <label><span class="public-required-label"><b>*</b> ชื่อผู้แจ้ง</span><%= form.text_field :reporter_name, required: true, maxlength: 120, autocomplete: "name" %></label><label><span class="public-required-label"><b>*</b> เบอร์ติดต่อ</span><%= form.telephone_field :reporter_contact, required: true, maxlength: 20, inputmode: "tel", autocomplete: "tel" %></label>
        </div>
        <label class="public-report-consent"><%= check_box_tag :consent, "1", params[:consent] == "1", required: true, data: { public_report_consent: true } %> <span class="public-required-label"><b>*</b> ยืนยันว่าข้อมูลที่แจ้งเป็นความจริง และยินยอมให้เจ้าหน้าที่ใช้ข้อมูลเพื่อดำเนินการเกี่ยวกับเหตุการณ์นี้</span></label>
      </section>

      <button type="submit" class="public-report-submit" data-public-report-submit disabled><span class="material-symbols-outlined">send</span>ส่งข้อมูลแจ้งเหตุ</button>
      <p class="public-report-submit-hint" data-public-submit-hint>กรุณากรอกข้อมูลที่มีเครื่องหมาย * ให้ครบถ้วน</p>
    <% end %>
  </div>

  <dialog class="public-photo-lightbox" data-public-photo-lightbox>
    <button type="button" class="public-photo-lightbox-close" data-public-photo-lightbox-close aria-label="ปิดภาพ">×</button>
    <img data-public-photo-lightbox-image alt="ภาพตัวอย่างขนาดใหญ่">
  </dialog>
</main>
<% if connect_url && !@liff_mode %>
  <dialog class="public-photo-lightbox public-line-choice" data-line-choice-dialog><section><h2>รับการแจ้งสถานะผ่าน LINE</h2><p>เชื่อมต่อก่อนแจ้งเหตุ เพื่อรับข้อความเมื่อส่งเรื่อง เจ้าหน้าที่รับเรื่อง และดำเนินการเสร็จสิ้น</p><%= link_to "เชื่อมต่อ LINE", connect_url, class: "public-report-submit" %><button type="button" class="public-report-again" data-skip-line>ดำเนินการโดยไม่เชื่อม LINE</button></section></dialog>
<% end %>
<% if @liff_mode %><script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script><% end %>
