<div class="shell dashboard-shell gis-dashboard data-layers-shell"><aside class="dashboard-sidebar sidebar"><div class="dashboard-brand brand"><span class="brand-symbol">⌂</span><div><strong>SMART TAMBON</strong><small>SMART GIS PLATFORM</small></div></div><div class="scope-summary"><small>พื้นที่ดำเนินการ</small><div><b><%= current_user.system_admin? ? "ทุกพื้นที่ทั่วประเทศ" : current_user.access_area&.name || "พื้นที่รับผิดชอบ" %></b></div></div><div class="sidebar-menu-label">เมนูหลัก</div><nav class="primary-nav"><%= link_to root_path, class: "primary-nav-item", data: { turbo: false } do %><span>⌂</span>ภาพรวมเมือง<% end %><%= link_to area_analysis_path, class: "primary-nav-item", data: { turbo: false } do %><span>⌖</span>การวิเคราะห์แผนที่<% end %><%= link_to disasters_path, class: "primary-nav-item", data: { turbo: false } do %><span>!</span>ภัยพิบัติและเหตุการณ์ <em>3</em><% end %><%= link_to data_layers_path, class: "primary-nav-item active", data: { turbo: false } do %><span>⇧</span>นำเข้าข้อมูล<% end %></nav><div class="sidebar-user user"><div class="avatar"><%= current_user.username.first.upcase %></div><div><b><%= current_user.username %></b><small><%= current_user.role_label %></small></div></div></aside><main class="dashboard-main content"><header class="dashboard-header gis-topbar"><div><p class="topbar-kicker">DATA MANAGEMENT</p><span class="breadcrumb">นำเข้าข้อมูล <b>›</b> ชุดข้อมูลแบบกำหนดเอง<% if @selected_dataset %> <b>›</b> <%= @selected_dataset.name %><% end %></span></div></header><div class="dashboard-content import-workspace"><section class="city-heading import-heading"><div><h1>นำเข้าข้อมูล</h1><p>จัดการชุดข้อมูลเฉพาะพื้นที่และโครงสร้างข้อมูลที่กำหนดเอง</p></div><button class="data-layer-add" type="button" data-open-custom-dialog>＋ สร้างชุดข้อมูล</button></section><div class="import-layout"><aside class="dataset-type-nav"><h3>ชุดข้อมูลตามระบบ</h3><%= link_to data_layers_path(data_type: "population"), class: "dataset-type-link" do %><span>▤</span>ข้อมูลประชากร<b>›</b><% end %><%= link_to data_layers_path(data_type: "resources"), class: "dataset-type-link" do %><span>▤</span>ทรัพยากรและอุปกรณ์<b>›</b><% end %><%= link_to data_layers_path(data_type: "workforce"), class: "dataset-type-link" do %><span>▤</span>ทีมงานและกำลังคน<b>›</b><% end %><h3>ชุดข้อมูลแบบกำหนดเอง</h3><%= link_to imported_datasets_path, class: "dataset-type-link custom active" do %><span>＋</span>รายการชุดข้อมูล<b>›</b><% end %><h3>คลังข้อมูลไฟล์</h3><%= link_to data_layers_path(data_type: "file_library"), class: "dataset-type-link" do %><span>▧</span>คลังข้อมูลไฟล์<b>›</b><% end %></aside><section class="dataset-catalog fixed-catalog"><div class="catalog-hero"><div><span>▧</span><div><h2>ชุดข้อมูลแบบกำหนดเอง</h2><p>เลือกชุดข้อมูลเพื่อเพิ่มข้อมูลด้วยตนเองหรือจากไฟล์</p></div></div><b><%= @datasets.size %> ชุดข้อมูล</b></div><div class="custom-dataset-list" data-initial-detail-url="<%= imported_dataset_path(@selected_dataset) if @selected_dataset %>"><% @datasets.each do |dataset| %><article data-updated-label="<%= thai_short_datetime(dataset.updated_at || dataset.created_at) %>" data-category-label="<%= dataset.category_label %>"><div><b><%= dataset.name %></b><small><%= dataset.record_count %> รายการ · <%= dataset.map_enabled? ? "แสดงบนแผนที่ (จุดตำแหน่ง)" : "ไม่แสดงบนแผนที่" %></small></div><div><%= link_to "จัดการข้อมูล", imported_dataset_path(dataset), class: "data-layer-add" %></div></article><% end %><% if @datasets.empty? %><p class="custom-empty">ยังไม่มีชุดข้อมูล กด “สร้างชุดข้อมูล” เพื่อเริ่มต้น</p><% end %></div></section></div></div></main></div>
<dialog class="dataset-modal" id="custom-dataset-dialog"><%= form_with url: imported_datasets_path, method: :post, data: { custom_dataset_form: true } do %><header><div><small>ชุดข้อมูลแบบกำหนดเอง</small><h2>สร้างชุดข้อมูล</h2></div><button type="button" data-close-custom-dialog>×</button></header><div class="modal-info">กำหนดประเภทการแสดงบนแผนที่และคอลัมน์ก่อนยืนยันสร้างชุดข้อมูล</div><div class="manual-fixed-grid"><label>ชื่อชุดข้อมูล *<input name="imported_dataset[name]" required placeholder="เช่น จุดเสี่ยงน้ำท่วม"></label><label>พื้นที่ *<select name="imported_dataset[subdistrict_id]" required><option value="">เลือกพื้นที่</option><% @subdistricts.each do |subdistrict| %><option value="<%= subdistrict.id %>"><%= subdistrict.name_th %> · <%= subdistrict.province.name_th %></option><% end %></select></label><label>การแสดงบนแผนที่<select name="imported_dataset[geometry_type]" data-geometry-type><option value="none">ไม่แสดงบนแผนที่</option><option value="point">จุดตำแหน่ง</option></select></label><label class="map-option"><input type="checkbox" name="imported_dataset[map_enabled]" value="1" data-map-enabled> สร้างชั้นข้อมูลบนแผนที่</label></div><section class="custom-schema-modal"><b>คอลัมน์ข้อมูล</b><div data-custom-schema></div><button type="button" class="button-link" data-add-custom-field>＋ เพิ่มคอลัมน์</button></section><input type="hidden" name="imported_dataset[data_type]" value="custom"><input type="hidden" name="schema_definition" data-custom-schema-json><footer><button type="button" class="button-link" data-close-custom-dialog>ยกเลิก</button><button class="data-layer-add" type="submit">ยืนยันและสร้างชุดข้อมูล</button></footer><% end %></dialog>
<%= javascript_tag nonce: true do %>
document.addEventListener("DOMContentLoaded",()=>{const dialog=document.querySelector("#custom-dataset-dialog"),open=document.querySelector("[data-open-custom-dialog]");if(!dialog||!open)return;let fields=[{key:"field_1",label:"ชื่อรายการ",type:"text",required:true}];const box=dialog.querySelector("[data-custom-schema]"),json=dialog.querySelector("[data-custom-schema-json]"),form=dialog.querySelector("form");const render=()=>{box.innerHTML=fields.map((field,index)=>`<div class="schema-row"><input data-label="${index}" value="${field.label}"><select data-type="${index}">${["text","number","date","boolean"].map(type=>`<option value="${type}" ${field.type===type?"selected":""}>${{text:"ข้อความ",number:"ตัวเลข",date:"วันที่",boolean:"ใช่/ไม่ใช่"}[type]}</option>`).join("")}</select><label><input type="checkbox" data-required="${index}" ${field.required?"checked":""}> จำเป็น</label><button type="button" data-remove="${index}">×</button></div>`).join("");json.value=JSON.stringify(fields)};open.addEventListener("click",()=>{render();dialog.showModal()});dialog.querySelectorAll("[data-close-custom-dialog]").forEach(button=>button.addEventListener("click",()=>dialog.close()));dialog.addEventListener("input",event=>{if(event.target.dataset.label!==undefined){const index=+event.target.dataset.label;fields[index].label=event.target.value;fields[index].key=`field_${index+1}`;json.value=JSON.stringify(fields)}});dialog.addEventListener("change",event=>{if(event.target.dataset.type!==undefined)fields[+event.target.dataset.type].type=event.target.value;if(event.target.dataset.required!==undefined)fields[+event.target.dataset.required].required=event.target.checked;if(event.target.matches("[data-geometry-type]")){const enabled=dialog.querySelector("[data-map-enabled]");enabled.checked=event.target.value==="point"}json.value=JSON.stringify(fields)});dialog.addEventListener("click",event=>{if(event.target.matches("[data-add-custom-field]")){fields.push({key:`field_${fields.length+1}`,label:`หัวข้อ ${fields.length+1}`,type:"text",required:false});render()}if(event.target.dataset.remove!==undefined){fields.splice(+event.target.dataset.remove,1);render()}});form.addEventListener("submit",event=>{if(!fields.length){event.preventDefault();alert("กรุณาเพิ่มอย่างน้อย 1 คอลัมน์")}json.value=JSON.stringify(fields)});});
<% end %>
<%= javascript_include_tag "custom_dataset_wizard", defer: true %>
<%= javascript_include_tag "custom_dataset_catalog", defer: true %>
<template data-shared-dashboard-sidebar><%= render "dashboard/sidebar", active_nav: :data_layers, initial_area: (current_user.access_area&.name || current_user.subdistrict&.name_th || "ประเทศไทย") %></template>
<%= javascript_tag nonce: true do %>
  document.addEventListener("DOMContentLoaded", () => {
    const template = document.querySelector("[data-shared-dashboard-sidebar]");
    const currentSidebar = document.querySelector(".dashboard-shell > .dashboard-sidebar");
    const sharedSidebar = template?.content.firstElementChild;
    if (currentSidebar && sharedSidebar) currentSidebar.replaceWith(sharedSidebar);
    template?.remove();
  }, { once: true });
<% end %>
