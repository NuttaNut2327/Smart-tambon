<div class="import-form-page">
  <header><%= link_to "← กลับรายการข้อมูล", data_layers_path, class: "button-link" %><div><small>นำเข้าชุดข้อมูล</small><h1><%= title %></h1></div></header>
  <% if alert %><div class="import-flash error"><%= alert %></div><% end %>
  <%= form_with model: @dataset, multipart: true, class: "dataset-builder", data: { dataset_form: true } do |form| %>
    <section class="builder-card"><div class="builder-card-title"><span>1</span><div><h2>ชื่อ ประเภท และพื้นที่</h2><p>ข้อมูลจะเข้าถึงได้เฉพาะผู้ใช้ที่มีสิทธิ์ในพื้นที่นี้</p></div></div><%= form.hidden_field :data_type %><div class="builder-grid"><label>ชื่อชุดข้อมูล<%= form.text_field :name, required: true, placeholder: "เช่น ศูนย์พักพิงชั่วคราว" %></label><label>ประเภทข้อมูล<input value="<%= @dataset.type_label %>" readonly></label><label>พื้นที่<%= form.collection_select :subdistrict_id, @subdistricts, :id, ->(x) { "#{x.name_th} · #{x.province.name_th}" }, { include_blank: current_user.system_admin? ? "ทุกพื้นที่" : "เลือกพื้นที่" }, required: !current_user.system_admin? %></label><label>รูปแบบตำแหน่ง<%= form.select :geometry_type, [["ไม่มีตำแหน่ง","none"],["จุดพิกัดบนแผนที่","point"]] %></label></div><label class="map-toggle"><%= form.check_box :map_enabled %><span>สร้างเป็นชั้นข้อมูลบนแผนที่</span><small>ต้องเลือก “จุดพิกัด” และกรอก latitude/longitude</small></label></section>
    <section class="builder-card"><div class="builder-card-title"><span>2</span><div><h2>โครงสร้างคอลัมน์</h2><p><%= @dataset.data_type == "custom" ? "เพิ่มหัวข้อและชนิดข้อมูลที่ต้องการเก็บ" : "ระบบกำหนดคอลัมน์มาตรฐานให้แล้ว" %></p></div></div><div class="schema-fields" data-schema-fields></div><% if @dataset.data_type == "custom" %><button type="button" class="button-link" data-add-field>＋ เพิ่มคอลัมน์</button><% end %><input type="hidden" name="schema_definition" data-schema-json value="<%= @dataset.schema_definition.to_json %>"></section>
    <section class="builder-card"><div class="builder-card-title"><span>3</span><div><h2>เพิ่มข้อมูลเริ่มต้น</h2><p>เลือกกรอกเองทีละรายการ หรืออัปโหลด CSV/XLS/XLSX</p></div></div><div class="import-method-tabs"><button type="button" class="active" data-method="manual">กรอกด้วยตนเอง</button><button type="button" data-method="file">นำเข้าจากไฟล์</button></div><div data-manual-panel><div class="manual-records" data-manual-records></div><button type="button" class="button-link" data-add-record>＋ เพิ่มรายการ</button><input type="hidden" name="manual_records" data-manual-json></div><div data-file-panel hidden><label class="dataset-dropzone">⇧<b>เลือกไฟล์ข้อมูล</b><small>รองรับ CSV, XLS และ XLSX · หัวคอลัมน์ใช้ชื่อไทยหรือ key ภาษาอังกฤษก็ได้</small><input type="file" name="file" accept=".csv,.xls,.xlsx"></label><button type="button" class="button-link" data-download-template>ดาวน์โหลด Template CSV</button></div><label class="change-note">รายละเอียดการนำเข้า<input type="text" name="change_note" placeholder="เช่น ข้อมูลสำรวจเดือนกันยายน"></label></section>
    <footer><%= link_to "ยกเลิก", data_layers_path, class: "button-link" %><button class="data-layer-add" type="submit"><%= submit_label %></button></footer>
  <% end %>
</div>
<%= javascript_tag nonce: true do %>
document.addEventListener("DOMContentLoaded",()=>{
 const form=document.querySelector("[data-dataset-form]");if(!form)return;const schemaInput=form.querySelector("[data-schema-json]"),schemaBox=form.querySelector("[data-schema-fields]"),recordsBox=form.querySelector("[data-manual-records]"),manualInput=form.querySelector("[data-manual-json]");let schema=JSON.parse(schemaInput.value||"[]"),records=[{}];const custom=<%= (@dataset.data_type == "custom").to_json %>;const esc=s=>String(s??"").replace(/[&<>\"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
 function renderSchema(){schemaBox.innerHTML=schema.map((f,i)=>`<div class="schema-row"><input data-field-label="${i}" value="${esc(f.label)}" ${custom?"":"readonly"}><select data-field-type="${i}" ${custom?"":"disabled"}>${["text","number","date","boolean"].map(t=>`<option value="${t}" ${f.type===t?"selected":""}>${{text:"ข้อความ",number:"ตัวเลข",date:"วันที่",boolean:"ใช่/ไม่ใช่"}[t]}</option>`).join("")}</select><label><input type="checkbox" data-field-required="${i}" ${f.required?"checked":""} ${custom?"":"disabled"}> จำเป็น</label>${custom?`<button type="button" data-remove-field="${i}">×</button>`:""}</div>`).join("");schemaInput.value=JSON.stringify(schema);renderRecords()}
 function renderRecords(){recordsBox.innerHTML=records.map((r,ri)=>`<div class="manual-record"><b>รายการ ${ri+1}</b><div>${schema.map(f=>`<label>${esc(f.label)}<input data-record="${ri}" data-key="${f.key}" type="${f.type==="number"?"number":f.type==="date"?"date":"text"}" value="${esc(r[f.key])}" ${f.required?"required":""}></label>`).join("")}</div>${records.length>1?`<button type="button" data-remove-record="${ri}">ลบรายการ</button>`:""}</div>`).join("")}
 form.addEventListener("input",e=>{if(e.target.dataset.record!==undefined)records[+e.target.dataset.record][e.target.dataset.key]=e.target.value;if(e.target.dataset.fieldLabel!==undefined){const i=+e.target.dataset.fieldLabel;schema[i].label=e.target.value;schema[i].key=`field_${i+1}`;schemaInput.value=JSON.stringify(schema)}});form.addEventListener("change",e=>{if(e.target.dataset.fieldType!==undefined)schema[+e.target.dataset.fieldType].type=e.target.value;if(e.target.dataset.fieldRequired!==undefined)schema[+e.target.dataset.fieldRequired].required=e.target.checked;schemaInput.value=JSON.stringify(schema)});
 form.addEventListener("click",e=>{if(e.target.matches("[data-add-field]")){schema.push({key:`field_${schema.length+1}`,label:`หัวข้อ ${schema.length+1}`,type:"text",required:false});renderSchema()}if(e.target.dataset.removeField!==undefined){schema.splice(+e.target.dataset.removeField,1);renderSchema()}if(e.target.matches("[data-add-record]")){records.push({});renderRecords()}if(e.target.dataset.removeRecord!==undefined){records.splice(+e.target.dataset.removeRecord,1);renderRecords()}if(e.target.dataset.method){const manual=e.target.dataset.method==="manual";form.querySelectorAll("[data-method]").forEach(x=>x.classList.toggle("active",x===e.target));form.querySelector("[data-manual-panel]").hidden=!manual;form.querySelector("[data-file-panel]").hidden=manual;form.querySelectorAll("[data-manual-panel] input").forEach(x=>x.disabled=!manual);form.querySelector("[data-file-panel] input[type=file]").disabled=manual}if(e.target.matches("[data-download-template]")){const csv="\uFEFF"+schema.map(f=>`\"${f.label}\"`).join(",")+"\n";const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([csv],{type:"text/csv"}));a.download="dataset_template.csv";a.click();URL.revokeObjectURL(a.href)}});form.addEventListener("submit",()=>{manualInput.value=JSON.stringify(records);schemaInput.value=JSON.stringify(schema)});form.querySelector("[data-file-panel] input[type=file]").disabled=true;renderSchema();
});
<% end %>
