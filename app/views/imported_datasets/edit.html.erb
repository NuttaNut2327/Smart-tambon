<div class="import-form-page"><header><%= link_to "← กลับ", @dataset, class: "button-link" %><div><small>ตั้งค่าชุดข้อมูล</small><h1>แก้ไข <%= @dataset.name %></h1></div></header><% if alert %><div class="import-flash error"><%= alert %></div><% end %><%= form_with model: @dataset, class: "dataset-builder" do |form| %><section class="builder-card"><div class="builder-grid"><label>ชื่อชุดข้อมูล<%= form.text_field :name, required: true %></label><label>พื้นที่<%= form.collection_select :subdistrict_id, @subdistricts, :id, ->(x) { "#{x.name_th} · #{x.province.name_th}" }, include_blank: current_user.system_admin? %></label><label>รูปแบบตำแหน่ง<%= form.select :geometry_type, [["ไม่มีตำแหน่ง","none"],["จุดพิกัด","point"]] %></label></div><label class="map-toggle"><%= form.check_box :map_enabled %> แสดงเป็นชั้นข้อมูลบนแผนที่</label></section><footer><%= link_to "ยกเลิก", @dataset, class: "button-link" %><button class="data-layer-add">บันทึก</button></footer><% end %></div>
