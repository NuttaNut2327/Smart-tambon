<div class="dataset-detail-page"><header><%= link_to "← กลับรายการข้อมูล", data_layers_path, class: "button-link" %><div><small><%= @dataset.type_label %></small><h1><%= @dataset.name %></h1><p><%= @dataset.subdistrict&.name_th || "ทุกพื้นที่" %> · เจ้าของ <%= @dataset.user.username %></p></div><div><%= link_to "ตั้งค่า", edit_imported_dataset_path(@dataset), class: "button-link" if current_user.system_admin? || current_user.id == @dataset.user_id %><%= link_to "ดูบนแผนที่", map_path, class: "data-layer-add" if @dataset.map_enabled? %></div></header><% if notice %><div class="import-flash success"><%= notice %></div><% end %><% if alert %><div class="import-flash error"><%= alert %></div><% end %>
  <section class="dataset-stat-grid"><article><small>ข้อมูลปัจจุบัน</small><b><%= @dataset.record_count %></b><span>รายการ</span></article><article><small>Version ปัจจุบัน</small><b>v<%= @dataset.current_version&.version_number || 0 %></b><span><%= @dataset.current_version&.created_at&.strftime("%d/%m/%Y %H:%M") %></span></article><article><small>ชั้นข้อมูลแผนที่</small><b><%= @dataset.map_enabled? ? "เปิด" : "ปิด" %></b><span><%= @dataset.geometry_type == "point" ? "จุดพิกัด" : "ไม่มี Geometry" %></span></article></section>
  <% current_records = Array(@dataset.current_version&.records) %><section class="builder-card"><div class="section-card-heading"><div><h2>ข้อมูล Version ปัจจุบัน</h2><p>ตัวอย่างสูงสุด 100 รายการ</p></div></div><div class="version-table-wrap"><table><thead><tr><% @dataset.schema_definition.each do |field| %><th><%= field["label"] %></th><% end %></tr></thead><tbody><% current_records.first(100).each do |record| %><tr><% @dataset.schema_definition.each do |field| %><td><%= record[field["key"]] %></td><% end %></tr><% end %></tbody></table></div></section>
  <% if current_user.system_admin? || current_user.id == @dataset.user_id %><section class="builder-card"><div class="builder-card-title"><span>＋</span><div><h2>สร้าง Version ใหม่</h2><p>แก้ข้อมูลเดิม/เพิ่มทีละรายการ หรือแทนที่ด้วยไฟล์ใหม่</p></div></div><div class="import-method-tabs"><button type="button" class="active" data-version-tab="manual">แก้ไขและกรอกเอง</button><button type="button" data-version-tab="file">นำเข้าไฟล์ใหม่</button></div>
    <%= form_with url: imported_dataset_versions_path(@dataset), multipart: true, data: { version_manual: true } do %><div data-version-manual-panel><div class="version-editor" data-version-editor></div><button type="button" class="button-link" data-version-add>＋ เพิ่มรายการ</button><input type="hidden" name="manual_records" data-version-records></div><div data-version-file-panel hidden><label class="dataset-dropzone">⇧<b>เลือก CSV, XLS, XLSX หรือ PDF</b><input type="file" name="file" accept=".csv,.xls,.xlsx,.pdf"></label></div><label class="change-note">รายละเอียดการเปลี่ยนแปลง<input name="change_note" required placeholder="ระบุสิ่งที่แก้ไขใน Version นี้"></label><button class="data-layer-add">ตรวจสอบและสร้าง Version ใหม่</button><% end %></section><% end %>
  <section class="builder-card"><div class="section-card-heading"><div><h2>ประวัติ Version และคลังไฟล์</h2><p>ทุก Version เป็น snapshot แยกกันและไม่ถูกเขียนทับ</p></div><span><%= @versions.size %> Version</span></div><div class="version-list"><% @versions.each do |version| %><article class="version-row"><div class="version-badge">v<%= version.version_number %></div><div><b><%= version.change_note.presence || "นำเข้าข้อมูล" %></b><small><%= version.source_kind %> · <%= version.records.size %> รายการ · <%= version.user.username %> · <%= version.created_at.strftime("%d/%m/%Y %H:%M") %></small><% if version.source_filename.present? %><em>ไฟล์: <%= version.source_filename %></em><% end %></div><div><%= link_to "ดูข้อมูล", imported_dataset_version_path(@dataset, version), class: "button-link" %><%= link_to "ดาวน์โหลดไฟล์", download_imported_dataset_version_path(@dataset, version), class: "button-link" if version.downloadable? %><%= button_to "สร้าง Version จากชุดนี้", restore_imported_dataset_version_path(@dataset, version), method: :post, class: "button-link" if current_user.system_admin? || current_user.id == @dataset.user_id %></div></article><% end %></div></section>
  <% if current_user.system_admin? || current_user.id == @dataset.user_id %><%= button_to "ลบ Dataset และประวัติทั้งหมด", @dataset, method: :delete, class: "dataset-danger", form: { data: { turbo_confirm: "ยืนยันลบ Dataset และทุก Version?" } } %><% end %>
</div>
<%= javascript_tag nonce: true do %>document.addEventListener("DOMContentLoaded",()=>{const schema=<%= raw @dataset.schema_definition.to_json %>;let records=<%= raw current_records.to_json %>;const editor=document.querySelector("[data-version-editor]"),hidden=document.querySelector("[data-version-records]");if(!editor)return;const esc=s=>String(s??"").replace(/[&<>\"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));function render(){editor.innerHTML=records.map((r,ri)=>`<div class="manual-record"><b>รายการ ${ri+1}</b><div>${schema.map(f=>`<label>${esc(f.label)}<input data-vrow="${ri}" data-vkey="${f.key}" value="${esc(r[f.key])}" ${f.required?"required":""}></label>`).join("")}</div><button type="button" data-vremove="${ri}">ลบ</button></div>`).join("")}editor.addEventListener("input",e=>{if(e.target.dataset.vrow!==undefined)records[+e.target.dataset.vrow][e.target.dataset.vkey]=e.target.value});editor.addEventListener("click",e=>{if(e.target.dataset.vremove!==undefined){records.splice(+e.target.dataset.vremove,1);render()}});document.querySelector("[data-version-add]")?.addEventListener("click",()=>{records.push({});render()});document.querySelector("[data-version-manual]")?.addEventListener("submit",()=>hidden.value=JSON.stringify(records));const fileInput=document.querySelector("[data-version-file-panel] input[type=file]");if(fileInput)fileInput.disabled=true;document.querySelectorAll("[data-version-tab]").forEach(button=>button.addEventListener("click",()=>{const manual=button.dataset.versionTab==="manual";document.querySelectorAll("[data-version-tab]").forEach(x=>x.classList.toggle("active",x===button));document.querySelector("[data-version-manual-panel]").hidden=!manual;document.querySelector("[data-version-file-panel]").hidden=manual;document.querySelectorAll("[data-version-manual-panel] input").forEach(x=>x.disabled=!manual);if(fileInput)fileInput.disabled=manual}));render()});<% end %>
