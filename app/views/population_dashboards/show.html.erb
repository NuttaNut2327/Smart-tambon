<% summary = @dataset.summary %>
<div class="shell dashboard-shell population-dashboard-shell">
  <aside class="dashboard-sidebar sidebar"><div class="dashboard-brand brand"><span class="brand-symbol">⌂</span><div><strong>SMART CITY</strong><small>Geo Administration Platform</small></div></div><nav class="primary-nav"><%= link_to root_path, class: "primary-nav-item" do %><span>⌂</span>หน้าหลัก<% end %><%= link_to data_layers_path, class: "primary-nav-item active" do %><span>▤</span>ชั้นข้อมูลของฉัน<% end %></nav><div class="sidebar-user user"><div class="avatar"><%= current_user.username.first.upcase %></div><div><b><%= current_user.username %></b><small><%= current_user.role_label %></small></div></div></aside>
  <main class="dashboard-main content"><header class="dashboard-header"><div class="breadcrumb"><span class="menu-glyph">☰</span><span>ชั้นข้อมูลของฉัน</span><b>›</b><span id="selection-label">Dashboard ประชากร</span></div><%= link_to "กลับรายการข้อมูล", data_layers_path, class: "button-link" %></header><div class="dashboard-content population-dashboard-content"><section class="dashboard-title-row"><div><p class="page-kicker">POPULATION DASHBOARD</p><h1>ศูนย์ติดตามประชากร ตำบล<%= @dataset.subdistrict.name_th %></h1><p>ข้อมูลจาก <%= @dataset.source_file %> · อัปโหลดเมื่อ <%= @dataset.created_at.strftime("%d/%m/%Y %H:%M") %></p></div></section>
    <div class="population-grid"><section class="population-map-card"><div><b>แผนที่ภาพรวมตำบล<%= @dataset.subdistrict.name_th %></b><small>ขอบเขตตำบลสำหรับติดตามข้อมูลประชากร</small></div><div id="population-map" data-subdistrict-id="<%= @dataset.subdistrict_id %>"></div></section><aside class="population-metrics"><article><span>ประชากรทั้งหมด</span><b><%= summary["total"].to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %></b><small>คน</small></article><article><span>จำนวนหมู่บ้าน</span><b><%= summary["villages"] %></b><small>หมู่บ้าน</small></article><article><span>ผู้สูงอายุ 65+</span><b><%= summary["age_65_plus"] %></b><small>คน</small></article><article><span>ต้องการความช่วยเหลือ</span><b><%= %w[chronic dialysis bedridden disabled psychiatric pregnant].sum { |key| summary[key].to_i } %></b><small>รายการ</small></article></aside></div>
    <section class="population-table-card"><div><h2>รายละเอียดรายหมู่บ้าน</h2><p>ข้อมูลประชากรและกลุ่มที่ต้องการความช่วยเหลือ</p></div><div class="population-table-wrap"><table><thead><tr><th>หมู่บ้าน</th><th>ประชากร</th><th>65+</th><th>เรื้อรัง</th><th>ล้างไต</th><th>ติดเตียง</th><th>พิการ</th><th>จิตเวช</th><th>ตั้งครรภ์</th></tr></thead><tbody><% @dataset.records.each do |row| %><tr><td><b>หมู่ <%= row["village_no"] %> · <%= row["village_name"] %></b><small><%= row["village_code"] %></small></td><td><%= row["total"] %></td><td><%= row["age_65_plus"] %></td><td><%= row["chronic"] %></td><td><%= row["dialysis"] %></td><td><%= row["bedridden"] %></td><td><%= row["disabled"] %></td><td><%= row["psychiatric"] %></td><td><%= row["pregnant"] %></td></tr><% end %></tbody></table></div></section></div></main>
</div>
<script>
  document.addEventListener("DOMContentLoaded", async () => { const target=document.querySelector("#population-map"); if(!target || !window.ol) return; const map=new ol.Map({target,layers:[new ol.layer.Tile({source:new ol.source.OSM()})],view:new ol.View({center:ol.proj.fromLonLat([100.5,14]),zoom:11})}); const response=await fetch(`/api/subdistricts/${target.dataset.subdistrictId}`); if(!response.ok)return; const feature=new ol.format.GeoJSON().readFeature(await response.json(),{featureProjection:"EPSG:3857"}); const source=new ol.source.Vector({features:[feature]}); map.addLayer(new ol.layer.Vector({source,style:new ol.style.Style({stroke:new ol.style.Stroke({color:"#159c80",width:3}),fill:new ol.style.Fill({color:"rgba(90,197,169,.12)"})})})); map.getView().fit(source.getExtent(),{padding:[30,30,30,30],maxZoom:13}); });
</script>
