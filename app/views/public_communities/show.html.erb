<%= stylesheet_link_tag "public_community", "data-turbo-track": "reload" %>
<main class="community-page" data-community-page>
  <script type="application/json" data-community-boundary><%= raw json_escape(@boundary_feature.to_json) %></script>
  <script type="application/json" data-community-items><%= raw json_escape(@map_items.to_json) %></script>
  <header class="community-header">
    <div class="community-brand">
      <%= image_tag(@setting.logo.present? ? logo_organization_settings_path(key: @setting.organization_key, v: @setting.logo["id"]) : system_logo_src, alt: "โลโก้ #{@setting.display_name(@area_name)}") %>
      <div><strong><%= @setting.display_name(@area_name) %></strong><small>ข้อมูลเหตุการณ์และข่าวสารชุมชน</small></div>
    </div>
    <%= link_to @report_url, class: "community-report-button" do %><span class="material-symbols-outlined">add_location_alt</span>แจ้งเหตุ<% end %>
  </header>

  <div class="community-container">
    <section class="community-intro">
      <div><p>ภาพรวมชุมชน</p><h1>สถานการณ์และข่าวสาร <%= @area_name %></h1><p>ติดตามเหตุที่เจ้าหน้าที่รับเรื่องแล้ว กิจกรรมในพื้นที่ และข่าวประชาสัมพันธ์จากหน่วยงาน</p></div>
      <small><span class="material-symbols-outlined">update</span>อัปเดตล่าสุด <%= thai_short_datetime(Time.current) %></small>
    </section>

    <section class="community-stats" aria-label="สรุปสถานการณ์">
      <article><span class="accepted material-symbols-outlined">task_alt</span><div><strong><%= @counts[:accepted] %></strong><small>รับเรื่องแล้ว</small></div></article>
      <article><span class="progress material-symbols-outlined">engineering</span><div><strong><%= @counts[:in_progress] %></strong><small>กำลังดำเนินการ</small></div></article>
      <article><span class="completed material-symbols-outlined">verified</span><div><strong><%= @counts[:completed] %></strong><small>เสร็จสิ้นใน 30 วัน</small></div></article>
      <article><span class="activity material-symbols-outlined">event</span><div><strong><%= @counts[:activities] %></strong><small>กิจกรรมในพื้นที่</small></div></article>
    </section>

    <nav class="community-filters" aria-label="กรองข้อมูล">
      <button type="button" class="active" data-community-filter="all">ทั้งหมด</button>
      <button type="button" data-community-filter="general">เหตุการณ์</button>
      <button type="button" data-community-filter="disaster">ภัยพิบัติ</button>
      <button type="button" data-community-filter="activity">กิจกรรม</button>
      <button type="button" data-community-filter="news">ข่าวประชาสัมพันธ์</button>
    </nav>

    <div class="community-layout">
      <section class="community-map-card">
        <div class="community-map" data-community-map aria-label="แผนที่สถานการณ์ในพื้นที่"></div>
        <div class="community-map-legend"><span><i class="accepted"></i>รับเรื่องแล้ว</span><span><i class="progress"></i>กำลังดำเนินการ</span><span><i class="activity"></i>กิจกรรม</span></div>
        <article class="community-map-detail" data-community-detail hidden></article>
      </section>

      <aside class="community-feed">
        <header><div><h2>รายการล่าสุด</h2><p>ไม่มีการแสดงข้อมูลผู้แจ้งและรูปภาพประกอบ</p></div><span><%= @map_items.size + @news.size %> รายการ</span></header>
        <div class="community-feed-list" data-community-feed>
          <% @map_items.each do |item| %>
            <button type="button" class="community-feed-item" data-community-item-id="<%= item[:id] %>" data-community-category="<%= item[:category] %>">
              <span class="community-feed-icon <%= item[:status] %>"><span class="material-symbols-outlined"><%= item[:category] == "activity" ? "event" : (item[:category] == "disaster" ? "warning" : "location_on") %></span></span>
              <span class="community-feed-copy"><b><%= item[:title] %></b><small><%= item[:incident_type] %> · <%= item[:status_label] %></small><time><%= thai_short_datetime(Time.zone.parse(item[:updated_at])) %></time></span>
            </button>
          <% end %>
          <% @news.each do |news| %>
            <article class="community-feed-item community-news-item" data-community-category="news">
              <span class="community-feed-icon news"><span class="material-symbols-outlined">campaign</span></span>
              <span class="community-feed-copy"><b><%= news[:title] %></b><small><%= news[:summary] %></small><time><%= thai_short_datetime(Time.zone.parse(news[:published_at])) %></time></span>
            </article>
          <% end %>
          <% if @map_items.empty? && @news.empty? %><div class="community-empty"><span class="material-symbols-outlined">inbox</span><p>ยังไม่มีเหตุการณ์หรือข่าวสารที่เผยแพร่</p></div><% end %>
        </div>
      </aside>
    </div>

    <section class="community-completed" aria-labelledby="community-completed-title" data-community-archive>
      <header>
        <div>
          <p>ผลการดำเนินงาน</p>
          <h2 id="community-completed-title">เหตุการณ์ที่ดำเนินการเสร็จสิ้นและข่าวสารล่าสุด</h2>
          <small>แสดงรายการย้อนหลังไม่เกิน 30 วัน โดยไม่เปิดเผยข้อมูลผู้แจ้งและรูปภาพประกอบ</small>
        </div>
        <span data-community-archive-count><%= @archive_items.size %> รายการ</span>
      </header>

      <div class="community-archive-filters">
        <div class="community-archive-types" role="group" aria-label="กรองประเภทรายการย้อนหลัง">
          <% [["all", "ทั้งหมด"], ["general", "เหตุการณ์"], ["disaster", "ภัยพิบัติ"], ["activity", "กิจกรรม"], ["news", "ข่าวประชาสัมพันธ์"]].each do |value, label| %>
            <button type="button" class="<%= 'active' if value == 'all' %>" data-community-archive-type="<%= value %>"><%= label %></button>
          <% end %>
        </div>
        <div class="community-archive-dates">
          <label>ตั้งแต่ <span class="community-date-input" role="button" tabindex="0"><input type="date" min="<%= 30.days.ago.to_date.iso8601 %>" max="<%= Time.zone.today.iso8601 %>" data-community-archive-from><span class="community-date-placeholder">เลือกวันที่</span><span class="community-date-icon material-symbols-outlined">calendar_month</span></span></label>
          <label>ถึง <span class="community-date-input" role="button" tabindex="0"><input type="date" min="<%= 30.days.ago.to_date.iso8601 %>" max="<%= Time.zone.today.iso8601 %>" data-community-archive-to><span class="community-date-placeholder">เลือกวันที่</span><span class="community-date-icon material-symbols-outlined">calendar_month</span></span></label>
          <button type="button" data-community-archive-reset>ล้างตัวกรอง</button>
        </div>
      </div>

      <% if @archive_items.any? %>
        <div class="community-completed-list">
          <% @archive_items.each do |item| %>
            <details class="community-completed-item" data-community-archive-item data-archive-category="<%= item[:category] %>" data-archive-date="<%= Time.zone.parse(item[:displayed_at]).to_date.iso8601 %>">
              <summary>
                <span class="community-completed-icon <%= item[:category] %> material-symbols-outlined"><%= item[:category] == "news" ? "campaign" : (item[:category] == "activity" ? "event" : (item[:category] == "disaster" ? "warning" : "verified")) %></span>
                <span class="community-completed-heading">
                  <b><%= item[:title] %></b>
                  <small><%= item[:incident_type] %><%= " · #{item[:location_name]}" if item[:location_name].present? %></small>
                </span>
                <span class="community-completed-date"><small><%= item[:category] == "news" ? "เผยแพร่เมื่อ" : "เสร็จสิ้นเมื่อ" %></small><time><%= thai_short_datetime(Time.zone.parse(item[:displayed_at])) %></time></span>
                <span class="community-completed-toggle material-symbols-outlined">expand_more</span>
              </summary>
              <div class="community-completed-detail">
                <% if item[:summary].present? %><p><%= item[:summary] %></p><% end %>
                <dl>
                  <% if item[:reference_code].present? %><div><dt>เลขที่เรื่อง</dt><dd><%= item[:reference_code] %></dd></div><% end %>
                  <div><dt>ประเภท</dt><dd><%= item[:category_label] %> · <%= item[:incident_type] %></dd></div>
                  <% if item[:location_name].present? %><div><dt>บริเวณ</dt><dd><%= item[:location_name] %></dd></div><% end %>
                  <% if item[:reported_at].present? %><div><dt>รับแจ้งเมื่อ</dt><dd><%= thai_short_datetime(Time.zone.parse(item[:reported_at])) %></dd></div><% end %>
                  <% if item[:confirmations].positive? %><div><dt>ผู้ยืนยันเหตุเพิ่มเติม</dt><dd><%= item[:confirmations] %> คน</dd></div><% end %>
                </dl>
              </div>
            </details>
          <% end %>
        </div>
        <div class="community-completed-empty" data-community-archive-empty hidden><span class="material-symbols-outlined">filter_alt_off</span><p>ไม่พบรายการตามตัวกรองที่เลือก</p></div>
      <% else %>
        <div class="community-completed-empty"><span class="material-symbols-outlined">task_alt</span><p>ยังไม่มีเหตุการณ์ที่เสร็จสิ้นหรือข่าวที่เผยแพร่ในช่วง 30 วันที่ผ่านมา</p></div>
      <% end %>
    </section>
  </div>
</main>
<%= javascript_include_tag "public_community", defer: true, "data-turbo-track": "reload" %>
