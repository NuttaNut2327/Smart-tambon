<% area_name = current_user.access_area&.name.presence || current_user.subdistrict&.name_th %>
<% system_map = system_setting.map_defaults %>
<% custom_layers = !@setting.map_layers.nil? %>
<% reporting_tab = action_name == "public_reporting" || params[:settings_tab] == "public_reporting" %>
<% page = reporting_tab ? { title: "ช่องทางการแจ้งเหตุประจำตำบล", description: "ตั้งค่าช่องทางที่ประชาชนใช้แจ้งเหตุผ่าน Public Form และ LINE OA พร้อมข้อความอัปเดตสถานะรายบุคคล", active: :public_reporting } : { title: "ตั้งค่าระบบ", description: "ข้อมูล อบต. การแจ้งเตือนภายใน แผนที่ และบริการของหน่วยงาน", active: :organization } %>
<%= render layout: "settings/frame", locals: { title: page[:title], kicker: "สำหรับผู้ดูแลประจำ อบต. · #{area_name}", description: page[:description], active: page[:active] } do %>
  <%= form_with model: @setting, url: organization_settings_path, method: :patch, html: { multipart: true, class: "settings-form" } do |form| %>
    <%= hidden_field_tag :settings_tab, "public_reporting" if reporting_tab %>
    <% if @setting.errors.any? %><div class="form-errors"><% @setting.errors.full_messages.each do |message| %><p><%= message %></p><% end %></div><% end %>

    <% unless reporting_tab %>
    <section class="settings-card" id="settings-organization">
      <header><span class="material-symbols-outlined">account_balance</span><div><h2>ข้อมูล อบต.</h2><p>แสดงบนหน้าแบบฟอร์มแจ้งเหตุสาธารณะ เพื่อให้ประชาชนรู้ว่าแจ้งถึงหน่วยงานใด</p></div><%= button_tag type: "button", class: "button-link settings-reset-button", data: { open_organization_reset: true } do %><span class="material-symbols-outlined">restart_alt</span>คืนค่าเริ่มต้น<% end %></header>
      <div class="settings-grid">
        <label>ชื่อหน่วยงาน<%= form.text_field :organization_name, placeholder: "เช่น องค์การบริหารส่วนตำบล#{area_name}" %></label>
        <label>ผู้บริหาร/นายก อบต.<%= form.text_field :executive_name %></label>
        <label class="span-2">ที่อยู่<%= form.text_area :address, rows: 2 %></label>
        <label>เบอร์โทร (แสดงบนหน้าแจ้งเหตุ)<%= form.telephone_field :phone, placeholder: "เช่น 054-123456" %></label>
        <label>อีเมล<%= form.email_field :email %></label>
        <label>เว็บไซต์<%= form.url_field :website, placeholder: "https://" %></label>
        <div class="settings-logo">
          <%= image_tag(@setting.logo.present? ? logo_organization_settings_path(key: @setting.organization_key, v: @setting.logo["id"]) : system_logo_src, alt: "โลโก้ อบต.") %>
          <div>
            <label>โลโก้ อบต.<%= file_field_tag "organization_setting[logo_file]", accept: ImageLibrary::ACCEPT %><small>ถ้าไม่ใส่ จะใช้โลโก้ของระบบ</small></label>
            <%= render "library_images/picker", field: "organization_setting[logo_library_image_id]", max: 1, label: "เลือกโลโก้จากคลังภาพ" %>
            <% if @setting.logo.present? %><label class="settings-check"><%= check_box_tag "organization_setting[remove_logo]", "1" %> ลบโลโก้</label><% end %>
          </div>
        </div>
      </div>
    </section>

    <% end %>

    <% if reporting_tab %>
    <section class="settings-card" id="settings-citizen-line">
      <header><span class="material-symbols-outlined">chat</span><div><h2>LINE OA สำหรับรับแจ้งเหตุประจำตำบล</h2><p>ช่องทางสำหรับประชาชนแจ้งเหตุผ่าน LIFF และรับข้อความอัปเดตสถานะเป็นรายบุคคล ค่าลับถูกเข้ารหัสและแยกจากตำบลอื่น</p></div></header>
      <div class="settings-grid">
        <label class="settings-switch span-2"><%= form.check_box :citizen_line_enabled %><span><b>เปิดใช้งาน LINE OA สำหรับรับแจ้งเหตุ</b><small><%= "เชื่อมต่อกับ #{@setting.citizen_line_bot_name}" if @setting.citizen_line_bot_name %></small></span></label>
        <label>LINE Login Channel ID<%= form.text_field :citizen_line_login_channel_id, placeholder: "Channel ID ของ LINE Login" %><small>ใช้ตรวจสอบตัวตน LIFF ไม่ใช่ Channel ID ของ Messaging API</small></label>
        <label>LIFF ID<%= form.text_field :citizen_line_liff_id, placeholder: "เช่น 1234567890-AbCdEf" %></label>
        <div class="span-2 settings-webhook-field"><div><b>LIFF Endpoint URL</b><small>คัดลอก URL นี้ไปใส่ใน LINE Developers → LINE Login → LIFF → Endpoint URL</small></div><div class="settings-webhook-control"><input type="text" readonly value="<%= liff_bootstrap_url %>" data-copy-source><button type="button" class="button-link" data-copy-link><span class="material-symbols-outlined">content_copy</span>คัดลอก</button></div></div>
        <label>Messaging API Channel access token<%= password_field_tag "organization_setting[citizen_line_channel_access_token]", nil, autocomplete: "new-password", placeholder: @setting.masked_citizen_line_channel_access_token || "ยังไม่ได้กำหนด" %><small>เว้นว่างเพื่อคงค่าเดิม</small><% if @setting.citizen_line_channel_access_token? %><span class="settings-check"><%= check_box_tag "organization_setting[clear_citizen_line_channel_access_token]", "1" %> ลบค่าที่บันทึก</span><% end %></label>
        <label>Messaging API Channel secret<%= password_field_tag "organization_setting[citizen_line_channel_secret]", nil, autocomplete: "new-password", placeholder: @setting.masked_citizen_line_channel_secret || "ยังไม่ได้กำหนด" %><small>ใช้ตรวจลายมือชื่อ Webhook</small><% if @setting.citizen_line_channel_secret? %><span class="settings-check"><%= check_box_tag "organization_setting[clear_citizen_line_channel_secret]", "1" %> ลบค่าที่บันทึก</span><% end %></label>
        <div class="span-2 settings-webhook-field">
          <div><b>Webhook URL เฉพาะตำบลนี้</b><small>นำ URL นี้ไปใส่ใน Messaging API ของ OA ตำบลนี้ และเปิด Use webhook</small></div>
          <div class="settings-webhook-control"><input type="text" readonly value="<%= citizen_line_webhook_url(organization_key: @setting.organization_key) %>" data-copy-source><button type="button" class="button-link" data-copy-link><span class="material-symbols-outlined">content_copy</span>คัดลอก</button></div>
        </div>
      </div>
      <div class="settings-actions"><%= button_tag type: "submit", form: "test-citizen-line-form", class: "button-link" do %><span class="material-symbols-outlined">network_check</span>ทดสอบ LINE OA ประชาชน<% end %></div>
    </section>

    <% end %>

    <% unless reporting_tab %>
    <dialog class="settings-confirm-dialog" data-organization-reset-dialog aria-labelledby="organization-reset-title">
      <div class="settings-confirm-dialog-heading"><span class="material-symbols-outlined">restart_alt</span><div><small>คืนค่าข้อมูลหน่วยงาน</small><h2 id="organization-reset-title">ยืนยันคืนค่าเริ่มต้น</h2></div><button type="button" data-close-organization-reset aria-label="ปิด">×</button></div>
      <div class="settings-confirm-dialog-body"><p>ข้อมูลพื้นฐานของ อบต. ที่กำหนดไว้จะถูกล้าง และหน้าแบบฟอร์มแจ้งเหตุจะกลับไปใช้ชื่อพื้นที่กับโลโก้เริ่มต้นของระบบ</p><ul><li>ชื่อหน่วยงานและชื่อผู้บริหาร</li><li>ที่อยู่ โทรศัพท์ อีเมล และเว็บไซต์</li><li>โลโก้ของหน่วยงาน</li></ul><p class="settings-confirm-dialog-note"><span class="material-symbols-outlined">info</span>การตั้งค่าการแจ้งเตือน แผนที่ และลิงก์แจ้งเหตุจะไม่ถูกเปลี่ยนแปลง</p></div>
      <div class="settings-confirm-dialog-actions"><button type="button" class="button-link" data-close-organization-reset>ยกเลิก</button><%= button_tag type: "submit", name: "reset_organization_information", value: "1", class: "button-link danger", formnovalidate: true do %><span class="material-symbols-outlined">restart_alt</span>ยืนยันคืนค่าเริ่มต้น<% end %></div>
    </dialog>

    <section class="settings-card" id="settings-notifications">
      <header><span class="material-symbols-outlined">notifications</span><div><h2>การแจ้งเตือน</h2><p>ใช้กับผู้ใช้ทุกคนของ อบต. นี้</p></div></header>
      <div class="settings-toggles">
        <label class="settings-switch"><%= form.check_box :notify_new_incidents %><span><b>แจ้งเตือนเหตุการณ์ใหม่</b><small>แสดงหน้าต่างแจ้งเตือนมุมขวาบนเมื่อมีเหตุการณ์ที่รอรับเรื่อง (ตัวเลขบนเมนูยังแสดงเสมอ)</small></span></label>
        <label class="settings-switch"><%= form.check_box :notification_sound %><span><b>เสียงแจ้งเตือน</b><small>เล่นเสียงสั้น ๆ เมื่อมีเหตุการณ์ใหม่เข้ามา (เบราว์เซอร์อาจต้องคลิกหน้าเว็บก่อนหนึ่งครั้ง)</small></span></label>
        <label class="settings-switch"><%= form.check_box :notify_pending_activities %><span><b>แสดงจำนวนกิจกรรมที่รอรับเรื่อง</b><small>แสดงตัวเลขบนเมนู "กิจกรรมในพื้นที่"</small></span></label>
      </div>
    </section>

    <section class="settings-card" id="settings-map">
      <header><span class="material-symbols-outlined">map</span><div><h2>ค่าเริ่มต้นแผนที่ของตำบล</h2><p>ใช้แทนค่าเริ่มต้นของระบบ สำหรับผู้ใช้ทุกคนของ อบต. นี้</p></div></header>
      <div class="settings-grid">
        <label>แผนที่ฐาน<%= form.select :map_basemap, SystemSetting::BASEMAPS.map { |value, label| [label, value] }, { include_blank: "ใช้ค่าของระบบ (#{SystemSetting::BASEMAPS[system_map[:basemap]]})" } %></label>
        <label>ระดับซูมเมื่อเปิดแผนที่ (8–18)<%= form.number_field :map_zoom, min: 8, max: 18, step: 1, placeholder: "อัตโนมัติตามขอบเขตพื้นที่" %><small>เว้นว่างเพื่อให้แผนที่ขยายพอดีกับขอบเขตพื้นที่</small></label>
        <fieldset class="settings-layers span-2"><legend>ชั้นข้อมูลที่เปิดไว้ตั้งแต่แรก</legend>
          <label class="settings-check"><%= radio_button_tag "organization_setting[map_layers_mode]", "system", !custom_layers, data: { layers_mode: true } %> ใช้ค่าของระบบ (<%= system_map[:layers].map { |key| SystemSetting::MAP_LAYERS[key] }.join(", ").presence || "ไม่เปิดชั้นใด" %>)</label>
          <label class="settings-check"><%= radio_button_tag "organization_setting[map_layers_mode]", "custom", custom_layers, data: { layers_mode: true } %> กำหนดเอง</label>
          <div class="settings-layer-options" data-layer-options>
            <% SystemSetting::MAP_LAYERS.each do |key, label| %><label class="settings-check"><%= check_box_tag "organization_setting[map_layers][]", key, (custom_layers ? @setting.map_layers : system_map[:layers]).include?(key), id: "org_layer_#{key}" %> <%= label %></label><% end %>
          </div>
        </fieldset>
      </div>
    </section>

    <section class="settings-card" id="settings-gistda">
      <header><span class="material-symbols-outlined">key</span><div><h2>คีย์ข้อมูลภัยพิบัติ GISTDA</h2><p>ใช้ดึงชั้นข้อมูลน้ำท่วม จุดความร้อน และภัยแล้งบนแผนที่ของ อบต. นี้ — คีย์ถูกเข้ารหัส และไม่ถูกส่งไปยังเบราว์เซอร์</p></div></header>
      <div class="settings-grid">
        <label class="span-2">GISTDA Disaster API key
          <%= password_field_tag "organization_setting[gistda_api_key]", nil, autocomplete: "new-password", placeholder: @setting.masked_gistda_api_key || (system_setting.gistda_api_key.present? ? "ใช้คีย์ของระบบ" : "ยังไม่ได้กำหนด") %>
          <small>สมัครได้ที่ disaster.gistda.or.th/services/open-api · <span class="settings-source <%= @setting.gistda_api_key.present? ? "settings" : (system_setting.gistda_api_key.present? ? "env" : "none") %>"><%= @setting.gistda_api_key.present? ? "ใช้คีย์ของ อบต." : (system_setting.gistda_api_key.present? ? "ใช้คีย์ของระบบ" : "ยังไม่มีคีย์ทั้งของ อบต. และของระบบ") %></span> · เว้นว่างเพื่อคงค่าเดิม</small>
          <% if @setting.gistda_api_key.present? %><span class="settings-check"><%= check_box_tag "organization_setting[clear_gistda_api_key]", "1" %> ลบคีย์ของ อบต. (กลับไปใช้คีย์ของระบบ)</span><% end %>
        </label>
      </div>
    </section>

    <% end %>

    <% if reporting_tab %>
    <section class="settings-card" id="settings-public-report">
      <header><span class="material-symbols-outlined">link</span><div><h2>Public Form และลิงก์รับแจ้งเหตุ</h2><p>ช่องทางให้ประชาชนและหน่วยงานเครือข่ายแจ้งเหตุในพื้นที่ โดยไม่ต้องเข้าสู่ระบบ</p></div></header>
      <div class="settings-toggles">
        <label class="settings-switch"><%= form.check_box :public_report_enabled %><span><b>เปิดรับแจ้งเหตุผ่านลิงก์สาธารณะ</b><small>เมื่อปิด ผู้ที่เปิดลิงก์จะเห็นข้อความปิดรับแจ้งชั่วคราวพร้อมเบอร์โทรของ อบต.</small></span></label>
      </div>
      <div class="settings-grid">
        <label class="span-2">ข้อความต้อนรับบนแบบฟอร์ม<%= form.text_area :public_report_welcome, rows: 3, placeholder: "เช่น กรณีเร่งด่วนที่มีผู้บาดเจ็บ กรุณาโทร 1669 ก่อนกรอกแบบฟอร์ม" %></label>
        <label class="span-2">แหล่งที่มาของผู้แจ้ง (บรรทัดละ 1 รายการ)<%= text_area_tag "organization_setting[report_sources_text]", @setting.report_sources_text, rows: 5 %><small>บรรทัดแรกคือแบบฟอร์มสำหรับประชาชน บรรทัดถัดไปคือหน่วยงานเครือข่าย — แต่ละรายการมีลิงก์ของตัวเองในหน้าเหตุการณ์ทั่วไป</small></label>
      </div>
      <div class="settings-links">
        <% @setting.report_sources.each do |source| %>
          <% url = public_incident_report_link(source_type: source["type"], source_name: source["name"]) %>
          <article class="settings-public-link">
            <header><span class="material-symbols-outlined"><%= source["type"] == "citizen" ? "groups" : "apartment" %></span><b><%= source["name"] %></b></header>
            <div class="settings-public-link-control"><input type="text" readonly value="<%= url %>" data-copy-source><button type="button" class="button-link" data-copy-link><span class="material-symbols-outlined">content_copy</span>คัดลอก</button><button type="button" class="button-link" data-open-qr data-qr-title="<%= source["name"] %>" data-qr-src="<%= public_report_qr_organization_settings_path(source_type: source["type"], source_name: source["name"]) %>" data-qr-download="<%= public_report_qr_organization_settings_path(source_type: source["type"], source_name: source["name"], download: "1") %>"><span class="material-symbols-outlined">qr_code_2</span>ดู QR</button><%= link_to public_report_qr_organization_settings_path(source_type: source["type"], source_name: source["name"], download: "1"), class: "button-link" do %><span class="material-symbols-outlined">download</span>บันทึก QR<% end %></div>
          </article>
          <% if @setting.citizen_liff_ready? %><% token = url.split("/report/", 2).last %><% liff_url = @setting.citizen_liff_url(liff_public_incident_report_path(token: token)) %><article class="settings-public-link settings-public-link-liff"><header><span class="material-symbols-outlined">chat</span><b>LIFF สำหรับ Rich menu — <%= source["name"] %></b></header><div class="settings-public-link-control compact"><input type="text" readonly value="<%= liff_url %>" data-copy-source><button type="button" class="button-link" data-copy-link><span class="material-symbols-outlined">content_copy</span>คัดลอก</button></div></article><% end %>
        <% end %>
      </div>
    </section>

    <dialog class="settings-qr-dialog" data-qr-dialog aria-labelledby="settings-qr-title">
      <header><div><small>QR Code แบบฟอร์มแจ้งเหตุ</small><h2 id="settings-qr-title" data-qr-modal-title></h2></div><button type="button" data-close-qr aria-label="ปิด">×</button></header>
      <div class="settings-qr-preview"><img data-qr-modal-image alt="QR Code สำหรับแบบฟอร์มแจ้งเหตุ"></div>
      <footer><button type="button" class="button-link" data-close-qr>ปิด</button><a class="button-link primary" data-qr-modal-download><span class="material-symbols-outlined">download</span>บันทึก QR</a></footer>
    </dialog>

    <% end %>
    <div class="settings-actions"><%= form.submit "บันทึกการตั้งค่าระบบ", class: "button-link primary" %><% if @setting.updated_by %><small>แก้ไขล่าสุดโดย <%= @setting.updated_by %> · <%= thai_short_datetime(@setting.updated_at) %></small><% end %></div>
  <% end %>
  <% if reporting_tab %>
    <%= form_with url: test_citizen_line_organization_settings_path, method: :post, id: "test-citizen-line-form" do %><% end %>
    <section class="settings-card settings-danger">
      <header><span class="material-symbols-outlined">sync_lock</span><div><h2>สร้างลิงก์แจ้งเหตุใหม่</h2><p>ใช้เมื่อลิงก์รั่วไหลหรือถูกใช้ผิดวัตถุประสงค์ ลิงก์ที่เคยแชร์ไว้ทั้งหมดจะใช้งานไม่ได้ทันที (ลิงก์ปัจจุบันรุ่นที่ <%= @setting.public_report_version %>)</p></div></header>
      <%= button_to regenerate_public_link_organization_settings_path, method: :post, class: "button-link danger", form: { data: { confirm_regenerate: true } } do %><span class="material-symbols-outlined">autorenew</span>สร้างลิงก์ใหม่<% end %>
    </section>
  <% end %>
<% end %>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const options = document.querySelector("[data-layer-options]");
    const sync = () => options?.querySelectorAll("input").forEach(input => { input.disabled = document.querySelector("[data-layers-mode]:checked")?.value !== "custom"; });
    document.querySelectorAll("[data-layers-mode]").forEach(input => input.addEventListener("change", sync));
    sync();
    document.querySelectorAll("[data-copy-link]").forEach(button => button.addEventListener("click", async () => {
      const input = button.parentElement.querySelector("[data-copy-source]");
      try { await navigator.clipboard.writeText(input.value); } catch { input.select(); document.execCommand("copy"); }
      button.lastChild.textContent = "คัดลอกแล้ว";
      setTimeout(() => { button.lastChild.textContent = "คัดลอก"; }, 1500);
    }));
    const qrDialog = document.querySelector("[data-qr-dialog]");
    document.querySelectorAll("[data-open-qr]").forEach(button => button.addEventListener("click", () => {
      qrDialog.querySelector("[data-qr-modal-title]").textContent = button.dataset.qrTitle;
      qrDialog.querySelector("[data-qr-modal-image]").src = button.dataset.qrSrc;
      qrDialog.querySelector("[data-qr-modal-download]").href = button.dataset.qrDownload;
      qrDialog.showModal();
    }));
    document.querySelectorAll("[data-close-qr]").forEach(button => button.addEventListener("click", () => qrDialog?.close()));
    qrDialog?.addEventListener("click", event => { if (event.target === qrDialog) qrDialog.close(); });
    document.querySelector("[data-confirm-regenerate]")?.addEventListener("submit", event => {
      if (!window.confirm("สร้างลิงก์ใหม่? ลิงก์แจ้งเหตุที่เคยแชร์ไว้ทั้งหมดจะใช้งานไม่ได้")) event.preventDefault();
    });
    const organizationResetDialog = document.querySelector("[data-organization-reset-dialog]");
    document.querySelector("[data-open-organization-reset]")?.addEventListener("click", () => organizationResetDialog?.showModal());
    document.querySelectorAll("[data-close-organization-reset]").forEach(button => button.addEventListener("click", () => organizationResetDialog?.close()));
  });
</script>
