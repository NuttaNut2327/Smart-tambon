<div class="shell dashboard-shell gis-dashboard incident-assessment-shell" data-user-role="<%= current_user.role %>">
  <%= render "dashboard/sidebar", active_nav: (@incident ? :disasters : :city_map), initial_area: (current_user.access_area&.name || current_user.subdistrict&.name_th || "ประเทศไทย"), assigned_subdistrict: @assigned_subdistrict, provinces: @provinces %>
  <main class="dashboard-main content">
    <header class="dashboard-header gis-topbar"><div><p class="topbar-kicker">SMART GIS PLATFORM</p><span class="breadcrumb"><span><%= current_user.access_area&.name.presence || current_user.subdistrict&.name_th || "ประเทศไทย" %></span><b>›</b><% if @incident %><span>ภัยพิบัติ</span><b>›</b><span>ประเมินสถานการณ์</span><% else %><span>แผนที่เมือง</span><% end %></span></div><div class="header-avatar"><%= current_user.username.first.upcase %></div></header>
    <div class="dashboard-content incident-assessment-page" data-incident-assessment data-city-map="<%= @incident.nil? %>" data-calculate-url="<%= @incident ? calculate_incident_assessment_path(@incident) : calculate_situation_assessment_path %>">
      <% if @incident.nil? %><script type="application/json" data-city-incidents><%= raw json_escape(@map_incidents.to_json) %></script><% end %>
      <section class="assessment-page-heading"><div><p class="page-kicker"><%= @incident ? "พื้นที่ประเมินผลกระทบ" : "เครื่องมือภูมิสารสนเทศ" %></p><h1><%= @incident ? @incident.title : "แผนที่เมือง" %></h1><p><%= @incident ? "#{@incident.reference_code} · " : "วิเคราะห์พื้นที่และสร้างแผนรับมือล่วงหน้า · " %>เลือกพื้นที่บนแผนที่เพื่อคำนวณประชากรและทรัพยากร</p></div><% if @incident %><%= link_to "กลับหน้ารายละเอียด", disasters_path(incident_id: @incident.id), class: "incident-secondary-action" %><% end %></section>
      <nav class="assessment-tool-tabs" role="tablist" aria-label="เครื่องมือวิเคราะห์"><% if @incident.nil? %><button type="button" class="active" role="tab" aria-selected="true" data-assessment-mode="map"><span class="material-symbols-outlined">map</span><span><b>แผนที่</b><small>ดูข้อมูลสถานที่บนแผนที่เมือง</small></span></button><% end %><button type="button" class="<%= 'active' if @incident %>" role="tab" aria-selected="<%= @incident.present? %>" data-assessment-mode="analysis"><span class="material-symbols-outlined">landscape</span><span><b>วิเคราะห์พื้นที่</b><small>กำหนดพื้นที่เพื่อคำนวณผลกระทบ</small></span></button><button type="button" role="tab" aria-selected="false" data-assessment-mode="simulation"><span class="material-symbols-outlined">waves</span><span><b>จำลองสถานการณ์</b><small>กำหนดจุดและข้อมูลเพื่อประเมินพื้นที่ผลกระทบ</small></span></button></nav>
      <% if @incident %><section class="assessment-event-card"><div><small>ประเภทเหตุการณ์</small><b><%= @incident.incident_type.presence || @incident.category_label %></b></div><div><small>ระดับความเร่งด่วน</small><b><%= { "critical" => "วิกฤต", "very_urgent" => "เร่งด่วนมาก", "urgent" => "เร่งด่วน", "non_urgent" => "ไม่เร่งด่วน", "general" => "ทั่วไป", "waiting" => "ไม่เร่งด่วน", "watch" => "เร่งด่วน" }[@incident.severity] %></b></div><div><small>สถานที่</small><b><%= @incident.location_name.presence || "ตำแหน่งที่แจ้งเหตุ" %></b></div><div><small>ผู้รับผิดชอบ</small><b><%= @incident.assigned_to.presence || "ยังไม่ได้มอบหมาย" %></b></div></section><% else %><section class="assessment-scenario-card"><label for="assessment-disaster-type">ประเภทภัยที่ต้องการวางแผน</label><select id="assessment-disaster-type" data-assessment-disaster-type><option value="flood">น้ำท่วม</option><option value="fire">ไฟป่าและ Hotspot</option><option value="wind">วาตภัยและพายุ</option><option value="drought">ภัยแล้ง</option><option value="other">ภัยอื่น ๆ</option></select><small>เลือกประเภทภัย แล้ววาดพื้นที่จำลองเพื่อค้นหากฎและทรัพยากรที่ต้องเตรียม</small></section><% end %>
      <div class="assessment-workspace">
        <section class="assessment-map-card">
          <div class="assessment-map-toolbar"><div class="assessment-basemap-tabs"><button type="button" class="active" data-basemap="road">ถนน</button><button type="button" data-basemap="satellite">ดาวเทียม</button><button type="button" data-basemap="3d">3D</button></div><% if @incident.nil? %><div class="city-place-controls" aria-label="เปิดปิดหมวดสถานที่"><% {government:["account_balance","สถานที่ราชการ"],education:["school","การศึกษา"],health:["heart_plus","สาธารณสุข"],culture:["folded_hands","ศาสนา/วัฒนธรรม"],tourism:["star","ท่องเที่ยว"],transport:["directions_car","คมนาคม"],service:["local_mall","ร้านค้า/บริการ"],emergency:["emergency_home","ฉุกเฉิน"]}.each do |key,(icon,label)| %><button type="button" class="active <%= key %>" data-city-place-toggle="<%= key %>" aria-pressed="true" title="<%= label %>"><span class="material-symbols-outlined"><%= icon %></span><span class="city-place-label"><%= label %></span></button><% end %></div><% end %></div>
          <div class="assessment-map-wrap"><div class="assessment-map" data-assessment-map data-incident-longitude="<%= @incident&.longitude %>" data-incident-latitude="<%= @incident&.latitude %>"></div><div class="assessment-cesium-map" data-assessment-cesium aria-label="แผนที่ภูมิประเทศ 3 มิติ"></div><div class="assessment-layer-panel"><b>ชั้นข้อมูลบนแผนที่</b><label><input type="checkbox" checked data-layer-toggle="boundary"> ขอบเขตพื้นที่ดูแล</label><label><input type="checkbox" checked data-layer-toggle="village-boundaries"> ขอบเขตหมู่บ้าน</label><label><input type="checkbox" checked data-layer-toggle="places"> สถานที่สำคัญ</label><label><input type="checkbox" checked data-layer-toggle="water"> สถานีวัดน้ำและฝน</label><% if @incident.nil? %><% @map_incident_sources.each_key do |source| %><label><input type="checkbox" checked data-city-incident-toggle="<%= source %>"> แจ้งเหตุโดย <%= source %></label><% end %><% end %></div><section class="city-place-detail" data-city-place-detail hidden><button type="button" data-close-place-detail aria-label="ปิดรายละเอียด">×</button><span class="material-symbols-outlined" data-place-detail-icon>location_on</span><div><small data-place-detail-category></small><h3 data-place-detail-name></h3><p data-place-detail-address></p><p data-place-detail-contact></p><a data-place-detail-link target="_blank" rel="noopener" hidden>ดูข้อมูลเพิ่มเติม</a></div></section></div>
        </section>
        <aside class="assessment-results">
          <div data-mode-panel="analysis"><section class="assessment-area-tools"><h3>เลือกพื้นที่</h3><p>เลือกพื้นที่บนแผนที่เพื่อเริ่มคำนวณ</p><div class="assessment-area-modes"><button type="button" data-area-mode="point"><span class="material-symbols-outlined">location_on</span>จุด</button><button type="button" data-area-mode="line"><span class="material-symbols-outlined">timeline</span>เส้น</button><button type="button" data-area-mode="polygon"><span class="material-symbols-outlined">pentagon</span>พื้นที่</button></div><label class="assessment-distance-control" data-distance-control>ระยะขยาย <output data-distance-output>1,000 เมตร</output><input type="range" min="0" max="10000" step="10" value="1000" data-area-distance></label><small data-area-status></small><button type="button" class="assessment-clear-area" data-clear-area disabled>ล้างพื้นที่เลือก</button></section><header class="assessment-result-heading"><h2>ผลการประเมินพื้นที่</h2></header></div>
          <div class="assessment-simulation-panel" data-mode-panel="simulation" hidden><header><h2>จำลองสถานการณ์</h2><p>กำหนดค่าจำลองแล้วปักจุดเริ่มต้นบนแผนที่</p></header><div class="simulation-fields"><label>รัศมีผลกระทบ (เมตร)<input type="number" min="100" max="20000" step="100" value="1000" data-simulation-radius></label><label>ระดับน้ำ (ม.)<input type="number" min="0" step="0.1" placeholder="ไม่ระบุ" data-simulation-metric="water_level"></label><label>ปริมาณฝน (มม.)<input type="number" min="0" step="0.1" placeholder="ไม่ระบุ" data-simulation-metric="rainfall"></label><label>ความเร็วลม (กม./ชม.)<input type="number" min="0" step="0.1" placeholder="ไม่ระบุ" data-simulation-metric="wind_speed"></label><label>จำนวน Hotspot (จุด)<input type="number" min="0" step="1" placeholder="ไม่ระบุ" data-simulation-metric="hotspot_count"></label></div><button type="button" class="incident-primary-action simulation-pick-button" data-pick-simulation-point><span class="material-symbols-outlined">location_on</span>ปักจุดจำลองบนแผนที่</button></div>
          <p class="assessment-mode-hint" data-assessment-hint></p>
          <div class="assessment-rule-picker" data-rule-picker hidden><label for="assessment-rule-select">กฎที่ผ่านเงื่อนไข</label><select id="assessment-rule-select" data-rule-select disabled><option value="">ยังไม่มีกฎที่ผ่านเงื่อนไข</option></select></div>
          <div class="assessment-kpis"><article class="assessment-area-kpi"><div><small>พื้นที่ได้รับผลกระทบ</small><b data-result-area>—</b></div><select data-area-unit aria-label="หน่วยพื้นที่"><option value="sq_km">ตร.กม.</option><option value="rai">ไร่</option><option value="sq_m">ตร.ม.</option></select></article><article><small>ประชากรโดยประมาณ</small><b data-result-population>—</b></article><article><small>ครัวเรือนโดยประมาณ</small><b data-result-households>—</b></article><article><small>หมู่บ้านโดยประมาณ</small><b data-result-villages>—</b></article></div>
          <section class="assessment-resource-result"><h3>ทรัพยากรที่ต้องใช้</h3><div data-resource-results><p>ยังไม่มีผลการคำนวณ</p></div></section>
          <% if @incident %><%= form_with url: incident_assessments_path(@incident), method: :post, scope: :assessment, local: true, html: { data: { assessment_save: true } } do |form| %><%= form.hidden_field :title, value: "ประเมินจากพื้นที่ผลกระทบ" %><%= form.hidden_field :area_sq_km, data: { save_area: true } %><%= form.hidden_field :affected_people, data: { save_population: true } %><%= form.hidden_field :affected_households, data: { save_households: true } %><%= form.hidden_field :resource_lines, data: { save_resources: true } %><label class="assessment-activate"><%= form.check_box :activate, checked: true %> ใช้ Version นี้ทันที</label><%= form.submit "บันทึกผลประเมินเป็น Version ใหม่", class: "incident-primary-action assessment-save", disabled: true, data: { save_button: true } %><% end %><% end %>
        </aside>
      </div>
    </div>
  </main>
</div>
