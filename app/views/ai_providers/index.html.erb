<%= stylesheet_link_tag "ai_assistant", "data-turbo-track": "reload" %>
<%= render layout: "settings/frame", locals: { title: "ผู้ให้บริการ AI (LLM)", kicker: "สำหรับผู้ดูแลระบบ (Super admin)", description: "โมเดลภาษาที่ผู้ช่วย AI ของทุก อบต. ใช้ — เพิ่มได้หลายรายการ ผู้ใช้เลือกได้ในแต่ละแชต", active: :ai } do %>
  <section class="settings-card">
    <header><span class="material-symbols-outlined">smart_toy</span><div><h2>รายการผู้ให้บริการ</h2><p>รายการที่ตั้งเป็นค่าเริ่มต้นจะถูกเลือกไว้เมื่อเริ่มแชตใหม่ คีย์ API ถูกเข้ารหัสและไม่แสดงกลับในหน้าเว็บ</p></div></header>
    <div class="settings-actions"><%= link_to new_ai_provider_path, class: "button-link primary" do %><span class="material-symbols-outlined">add</span>เพิ่มผู้ให้บริการ<% end %></div>
    <% if @providers.empty? %>
      <div class="cctv-empty"><span class="material-symbols-outlined">smart_toy</span><b>ยังไม่มีผู้ให้บริการ AI</b><small>เพิ่มอย่างน้อย 1 รายการเพื่อเปิดใช้เมนูผู้ช่วย AI ของทุก อบต.</small></div>
    <% else %>
      <ul class="ai-provider-list">
        <% @providers.each do |provider| %>
          <li class="<%= 'is-default' if provider.is_default? %> <%= 'is-disabled' unless provider.enabled? %>">
            <div class="ai-provider-info">
              <div class="ai-provider-name">
                <%= link_to provider.name, edit_ai_provider_path(provider) %>
                <% if provider.is_default? %><span class="project-approval approved">ค่าเริ่มต้น</span><% end %>
                <span class="project-status <%= provider.enabled? ? 'in_progress' : 'suspended' %>"><%= provider.enabled? ? "เปิดใช้" : "ปิดใช้" %></span>
              </div>
              <dl>
                <div><dt>รูปแบบ API</dt><dd><%= AiProvider::API_FORMATS[provider.api_format]&.split(" (")&.first %></dd></div>
                <div><dt>โมเดล</dt><dd><code><%= provider.model %></code><% if provider.effort.present? %> · effort <%= provider.effort %><% end %></dd></div>
                <div><dt>Endpoint</dt><dd><%= provider.base_url.presence || "api.anthropic.com" %></dd></div>
                <div><dt>API key</dt><dd><%= provider.masked_api_key || (provider.anthropic? && ENV["ANTHROPIC_API_KEY"].present? ? "ใช้ค่าจาก .env" : "ไม่ได้กำหนด") %></dd></div>
              </dl>
            </div>
            <div class="ai-provider-actions">
              <% unless provider.is_default? %>
                <%= button_to make_default_ai_provider_path(provider), method: :patch, class: "button-link", disabled: !provider.enabled?, title: (provider.enabled? ? nil : "เปิดใช้งานก่อนจึงตั้งเป็นค่าเริ่มต้นได้") do %><span class="material-symbols-outlined">star</span>ตั้งเป็นค่าเริ่มต้น<% end %>
              <% end %>
              <%= button_to test_ai_provider_path(provider), method: :post, class: "button-link" do %><span class="material-symbols-outlined">network_check</span>ทดสอบ<% end %>
              <%= link_to edit_ai_provider_path(provider), class: "button-link" do %><span class="material-symbols-outlined">edit</span>แก้ไข<% end %>
              <%= button_to ai_provider_path(provider), method: :delete, class: "button-link danger", form: { onsubmit: "return confirm('ลบผู้ให้บริการ #{j provider.name}?')" } do %><span class="material-symbols-outlined">delete</span>ลบ<% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
