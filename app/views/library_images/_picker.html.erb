<%# "เลือกจากคลังภาพ" button; image_library.js adds the chosen ids as hidden inputs named `field` right after it.
    `selected` keeps earlier picks when a form re-renders after a validation error. %>
<button type="button" class="button-link image-library-pick" data-image-library-picker data-field="<%= field %>" data-max="<%= local_assigns[:max] || 20 %>"><span class="material-symbols-outlined" aria-hidden="true">photo_library</span><%= local_assigns[:label] || "เลือกจากคลังภาพ" %></button>
<div class="image-library-selection" data-image-library-selection><% Array(local_assigns[:selected]).each do |image| %><span class="image-library-chip" data-id="<%= image.id %>" data-title="<%= image.title %>" data-thumb-url="<%= library_image_file_path(image, variant: "thumb") %>"><img src="<%= library_image_file_path(image, variant: "thumb") %>" alt=""><b><%= image.title %></b><input type="hidden" name="<%= field %>" value="<%= image.id %>"><button type="button" aria-label="นำออก" data-chip-remove>×</button></span><% end %></div>
