<div class="dataset-detail-page"><header><%= link_to "← กลับ Dataset", @dataset, class: "button-link" %><div><small><%= @dataset.name %></small><h1>Version <%= @version.version_number %></h1><p><%= @version.change_note.presence || "นำเข้าข้อมูล" %> · <%= @version.created_at.strftime("%d/%m/%Y %H:%M") %></p></div><%= link_to "ดาวน์โหลดไฟล์ต้นฉบับ", download_imported_dataset_version_path(@dataset, @version), class: "data-layer-add" if @version.downloadable? %></header><section class="builder-card"><div class="version-table-wrap"><table><thead><tr><% @dataset.schema_definition.each do |field| %><th><%= field["label"] %></th><% end %></tr></thead><tbody><% @version.records.each do |record| %><tr><% @dataset.schema_definition.each do |field| %><td><%= record[field["key"]] %></td><% end %></tr><% end %></tbody></table></div></section></div>
