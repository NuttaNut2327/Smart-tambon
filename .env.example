MAPTILER_KEY=your_maptiler_key
LONGDO_MAP_KEY=your_longdo_map_key
LONGDO_CACHE_TTL=86400
# Building footprint vector tiles (TileJSON or {z}/{x}/{y}.pbf); the settings page value wins.
BUILDING_TILES_URL=
SAMPLE_USER_PASSWORD=choose_a_strong_sample_password
MINIO_ACCESS_KEY=choose_a_minio_access_key
MINIO_SECRET_KEY=choose_a_strong_minio_secret
MINIO_BUCKET=smart-tambon-incidents
MQTT_USERNAME=smart_tambon
MQTT_PASSWORD=change-me
# NASA FIRMS active fire hotspots. Optional: without a key the sync reads FIRMS' public Southeast Asia 24h files.
# A free MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/) enables the area API and FIRMS_DAY_RANGE.
FIRMS_MAP_KEY=
# Optional overrides: comma-separated sources, west,south,east,north bbox, 1-5 days per fetch, days kept
# FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
# FIRMS_BBOX=97.3,5.6,105.7,20.5
# FIRMS_DAY_RANGE=2
# FIRMS_RETENTION_DAYS=30

# Standalone weather service (services/weather). Admin key lets the dashboard register each user's tambon
# as a forecast location; it must match WEATHER_ADMIN_API_KEY in services/weather/.env.
WEATHER_API_URL=http://host.docker.internal:8010
WEATHER_ADMIN_API_KEY=

# GISTDA Disaster Open API (flood / VIIRS hotspot / drought layers), key from https://disaster.gistda.or.th/services/open-api
# Can also be set on the system settings page; each อบต. may set its own key on its settings page.
# Data is fetched and cached by the weather service (needs WEATHER_API_URL + WEATHER_ADMIN_API_KEY above).
GISTDA_API_KEY=
