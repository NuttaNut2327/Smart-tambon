# Copy to .env (never commit .env)
POSTGRES_USER=weather
POSTGRES_PASSWORD=change-me
POSTGRES_DB=weather
# Host port for the service's own PostGIS (Rails stack already uses 5432)
WEATHER_DB_HOST_PORT=5442
# Host port for the REST API (Rails uses 3000)
WEATHER_API_HOST_PORT=8010

# Required for POST /api/v1/weather/sync and location create/update/delete
WEATHER_ADMIN_API_KEY=change-me-to-a-long-random-string

# Providers (verified against https://open-meteo.com/en/docs on 2026-10-16)
WEATHER_PRIMARY_PROVIDER=open_meteo_ecmwf
WEATHER_SECONDARY_PROVIDER=open_meteo_gfs
WEATHER_FORECAST_DAYS=8
WEATHER_DEFAULT_TIMEZONE=Asia/Bangkok
WEATHER_INITIAL_SYNC=true
LOG_LEVEL=INFO
